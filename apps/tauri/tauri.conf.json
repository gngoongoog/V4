{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BRAINTRADE NEXT",
  "version": "0.25.1",
  "identifier": "com.braintrade.terminal.next",
  "build": {
    "beforeDevCommand": "npm --prefix apps/terminal run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../terminal/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "title": "BRAINTRADE V4 \u2014 Enterprise V25",
        "width": 1648,
        "height": 928,
        "minWidth": 1120,
        "minHeight": 730,
        "center": true,
        "backgroundColor": "#04101a",
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "mt5/": "mt5/"
    }
  }
}
