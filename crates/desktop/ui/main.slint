                    Rectangle {
                        width:315px;min-height:183px;
                        background:root.theme-choice==1?#ffffff:root.theme-choice==2?#292e35:#162231;
                        border-radius:13px;border-width:1px;border-color:root.theme-choice==1?#dfe6ef:#2c4053;
