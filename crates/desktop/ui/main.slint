            CheckBox { text: "تشغيل قاطع الخسارة اليومي على Demo (مطفأ افتراضياً لحرية التجارب)"; checked <=> root.daily-breaker-demo-enabled; enabled: root.state == "STOPPED" && !root.busy; }
            CheckBox { text: "تشغيل قاطع الخسارة اليومي على REAL (مفعّل افتراضياً)"; checked <=> root.daily-breaker-real-enabled; enabled: root.state == "STOPPED" && !root.busy; }
            HorizontalBox { Text { text: "حد الخسارة اليومية % (0.1–10) عند تفعيل القاطع"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.daily-limit; } }
            Text { text: "عند التفعيل يُحسب التراجع اليومي من Equity ونتيجة الصفقات لجميع الرموز على الحساب، ويُقفل الدخول حتى اليوم التالي بتوقيت بغداد؛ الإطفاء يسمح بالدخول لكنه لا يمسح سجل القفل. إطفاؤه في REAL يزيد خطر استنزاف رأس المال. تعلّم العقول وتجارب SHADOW/PAPER لا تتوقف بسبب القاطع."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            HorizontalBox { Text { text: "حد التراجع من القمة % (0.1–30)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.drawdown-limit; } }
            HorizontalBox { Text { text: "أقصى سبريد كنسبة ATR (0.01–1)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.spread-limit; } }
            HorizontalBox { Text { text: "سقف اللوت (0.001–100)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.max-lots; } }
            HorizontalBox { Text { text: "عمولة ذهاب وإياب / لوت / عملة الحساب"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.risk-commission-lot; } }
            HorizontalBox { Text { text: "انزلاق مفترض لكل جانب / ticks (0–1000)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; } LineEdit { text <=> root.slippage-ticks; } }
            Button { text: "حفظ إعدادات المخاطرة"; enabled: !root.busy && root.state == "STOPPED"; clicked => { root.save-risk(); } }
            Text { text: "SL = 1.5 ATR؛ الهدف ضعف مسافة SL؛ خروج زمني بعد 30 دقيقة. صفقة افتراضية واحدة لكل حساب ورمز. STOP يمنع الدخول ويبقي مخارج المحاكاة فعالة أثناء عمل المحرك."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: "الحد اليومي يتجدد بتوقيت بغداد. قفل التراجع يبقى بعد بلوغه؛ تغيير الإعدادات لا يمسح النتائج أو يفك القفل."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
        } }
        if root.page == 7: ScrollView { VerticalBox {
