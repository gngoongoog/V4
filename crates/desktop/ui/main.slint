            }
            Text { text: "النتيجة المعروضة / تجربة محفوظة"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
            Button {text: "تجربة الاستراتيجية المختارة على بيانات النتيجة المحددة"; enabled: !root.bt-busy && !root.bt-active && root.bt-selected >= 0; clicked => {root.backtest-action("experiment");}}
            Text {text: "التجربة على نتيجة محفوظة تغيّر الاستراتيجية فقط؛ رأس المال والسبريد والمخاطرة تبقى من تلك النتيجة."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap;}
            HorizontalLayout { spacing: 12px;
                Card { theme-choice: root.theme-choice; label: "NET / الصافي"; value: root.bt-net; }
                Card { theme-choice: root.theme-choice; label: "TRADES / الصفقات"; value: root.bt-trades; }
                Card { theme-choice: root.theme-choice; label: "MAX DRAWDOWN / التراجع"; value: root.bt-drawdown; }
            }
            Text { text: root.bt-report; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; font-size: 14px; }
            Text { text: "نموذج شموع تقريبي: وقف أولاً عند لمس الوقف والهدف معاً، ولا ملء للفجوات. ليست نتيجة تنفيذ حقيقي أو اختباراً خارج العينة. التصدير يضم تقرير HTML مع منحنى الرصيد وCSV/JSON كاملين."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
        } }
        if root.page == 8: ScrollView {VerticalBox {spacing: 12px;
            Text {text: "OFFICIAL NEWS / الأخبار الرسمية"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px;}
            Text {text: "عناوين من الاحتياطي الفدرالي والبنك المركزي الأوروبي. وقت الخبر UTC؛ تحديث الاتصال لا يعني أن الخبر جديد."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap;}
            HorizontalBox {
                Button {text: "تحديث الآن"; enabled: root.news-enabled && !root.news-refreshing; clicked => {root.news-action("refresh");}}
                Button {text: root.news-enabled ? "إيقاف تحديث الأخبار" : "تفعيل تحديث الأخبار"; clicked => {root.news-action(root.news-enabled ? "disable" : "enable");}}
            }
            Text {text: root.news-status; color: root.theme-choice == 1 ? #28384b : #e0e2e5; wrap: word-wrap;}
            Text {text: root.news-sources; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; horizontal-alignment: left; font-size: 13px;}
            Text {text: "عناوين منشورة؛ ليست تقويماً للأحداث القادمة. التصنيف بالكلمات لا يحدد أثر الخبر أو اتجاه السعر، ولا يدخل في قرار Meta أو الاختبار التاريخي."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap;}
            if root.news-empty: Text {text: "لا توجد عناوين محفوظة. راجع حالة المصادر أعلاه."; color: root.theme-choice == 1 ? #28384b : #e0e1e4;}
            for item in root.news-items: Rectangle {background: root.theme-choice == 1 ? #ffffff : #212329; border-radius: 8px;
                VerticalLayout {padding: 14px; spacing: 8px;
                    Text {text: item.title; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 16px; wrap: word-wrap; horizontal-alignment: left;}
                    Text {text: item.detail; color: root.theme-choice == 1 ? #62758b : #a5a8b0; font-size: 12px; wrap: word-wrap; horizontal-alignment: left;}
                    Button {text: "فتح الخبر في موقع المصدر"; clicked => {root.open-news(item.url);}}
                }
            }
        }}
        if root.page == 9: ScrollView { VerticalBox {
            spacing: 12px;
            Text { text: "CHRONOLOGICAL EVALUATION / التقييم الزمني"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px; }
            Text { text: "يقارن Meta v1 وMeta v2 على نفس History والتكاليف ضمن نوافذ زمنية مستقلة. لا يوجد random split ولا tuning تلقائي ولا ترقية نموذج."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: "مصدر التقييم — اختبارات Meta المحفوظة فقط"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
            ComboBox { model: root.ev-source-runs; current-index <=> root.ev-source-selected; }
            Text { text: "خطة التقسيم"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
            ComboBox { model: ["Holdout — development ثم جزء أخير محجوز", "Rolling — نوافذ development/holdout متتابعة"]; current-index <=> root.ev-plan; }
            if root.ev-plan == 0: HorizontalBox {
                Text { text: "نسبة Holdout %"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                LineEdit { text <=> root.ev-holdout-percent; placeholder-text: "30"; }
            }
            if root.ev-plan == 1: HorizontalBox {
                Text { text: "Development days"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                LineEdit { text <=> root.ev-development-days; }
                Text { text: "Holdout days"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                LineEdit { text <=> root.ev-holdout-days; }
                Text { text: "Step days"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                LineEdit { text <=> root.ev-step-days; }
            }
            Text { text: "كل نافذة تبدأ بدفتر صفقات ورأس مال افتراضي جديد؛ الإحماء يقرأ شموعاً أقدم فقط ولا يسمح بدخول قبل بداية النافذة."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "تشغيل التقييم الزمني"; enabled: !root.ev-busy && !root.ev-active && root.ev-source-selected >= 0; clicked => { root.evaluation-action("start"); } }
                Button { text: "إلغاء"; enabled: !root.ev-busy && root.ev-active; clicked => { root.evaluation-action("cancel"); } }
                Button { text: "تحديث المصادر والأدلة"; enabled: !root.ev-busy; clicked => { root.evaluation-action("refresh"); } }
            }
            Text { text: root.ev-status; color: root.theme-choice == 1 ? #28384b : #e0e2e5; wrap: word-wrap; font-size: 14px; }
            Text { text: "أدلة تقييم محفوظة immutable"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
            ComboBox { model: root.ev-runs; current-index <=> root.ev-selected; }
            HorizontalBox {
                Button { text: "فتح الدليل المختار"; enabled: !root.ev-busy && root.ev-selected >= 0; clicked => { root.evaluation-action("load"); } }
                Button { text: "تصدير JSON + هوية المصدر"; enabled: !root.ev-busy && root.ev-selected >= 0; clicked => { root.evaluation-action("export"); } }
            }
            HorizontalLayout { spacing: 12px;
                Card { theme-choice: root.theme-choice; label: "META V1 NET-SUM"; value: root.ev-v1-net; }
                Card { theme-choice: root.theme-choice; label: "META V2 NET-SUM"; value: root.ev-v2-net; }
                Card { theme-choice: root.theme-choice; label: "AVG Δ NET V2−V1"; value: root.ev-delta; }
            }
            Text { text: root.ev-report; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; font-size: 14px; }
            Text { text: "مهم: net-sum والمتوسطات تجمع نوافذ مستقلة وليست منحنى حساب متصل. Holdout/rolling دليل تقييم بحثي فقط، وليس إثبات ربحية ولا إذناً لـShadow أو LIVE."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
        } }
        if root.page == 10: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "فرص السوق — طلب وعرض، ارتداد، اختراق وزخم"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px; wrap: word-wrap; }
            Text { text: "تتغير الخطة مع السعر، وتُسحب عند الإيقاف أو تقادم البيانات. قوة الخصائص ليست احتمال نجاح."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            Text { text: root.opportunities; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; }
            Button { text: "عرض آخر 100 فرصة محفوظة"; clicked => { root.load-opportunity-history(); } }
            Text { text: root.opportunity-history; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 12: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "خريطة السوق والعقول المتخصصة"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px; }
            Text { text: "المناطق والقمم والقيعان • الزخم والتباعد • Gann • DOM • ملف نشاط ticks والجلسات"; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: root.market-map; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 11: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "التعلم والتوقعات البحثية"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px; }
            Text { text: root.learning-status; color: root.theme-choice == 1 ? #28384b : #e0e2e5; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "تحديث"; enabled: !root.learning-busy; clicked => { root.learning-action("refresh"); } }
                Button { text: "تصدير بيانات التدريب"; enabled: !root.learning-busy; clicked => { root.learning-action("export"); } }
                Button { text: "استيراد نموذج JSON"; enabled: !root.learning-busy; clicked => { root.learning-action("register"); } }
            }
            Text { text: root.learning-summary; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; }
            Text { text: "راجع هوية النموذج والدليل الزمني في التفاصيل قبل التسجيل. تسجيل الأهلية يتيح توقعات مراقبة فقط."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            LineEdit { text <=> root.learning-note; placeholder-text: "ملاحظة المراجعة (حتى 500 حرف)"; }
            Button { text: "تسجيل أهلية المراجعة الحالية"; enabled: !root.learning-busy && root.learning-review-ready; clicked => { root.learning-action("review"); } }
            HorizontalBox {
                Button { text: "تفاصيل النموذج والدليل"; enabled: !root.learning-busy; clicked => { root.learning-action("details"); } }
                Button { text: "التوقعات"; enabled: !root.learning-busy; clicked => { root.learning-action("predictions"); } }
                Button { text: "نتائج التوقعات"; enabled: !root.learning-busy; clicked => { root.learning-action("outcomes"); } }
                Button { text: "سجل المراجعات"; enabled: !root.learning-busy; clicked => { root.learning-action("records"); } }
            }
            HorizontalBox {
                Button { text: "تفاصيل أداء النموذج"; enabled: !root.learning-busy; clicked => { root.learning-action("performance"); } }
                Button { text: "حفظ مراجعة الأداء الحالية"; enabled: !root.learning-busy && root.learning-performance-ready; clicked => { root.learning-action("freeze"); } }
            }
            LineEdit { text <=> root.learning-record; placeholder-text: "معرّف مراجعة الأداء المحفوظة من السجل"; }
            Button { text: "فتح المراجعة المحفوظة"; enabled: !root.learning-busy && root.learning-record != ""; clicked => { root.learning-action("report"); } }
            Text { text: root.learning-detail; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; horizontal-alignment: left; }
        } }
        Rectangle { height: 1px; background: root.theme-choice == 1 ? #e3e9f0 : #3b3e45; }
        Text { text: root.feedback; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; min-height: 36px; }
        HorizontalLayout {
            Text { text: "Core يبقى شغالاً عند إغلاق النافذة."; color: root.theme-choice == 1 ? #687b90 : #878b94; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: "خروج كامل"; enabled: !root.busy; clicked => { root.action("shutdown"); } }
        }
            }
    }
}
