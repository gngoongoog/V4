                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 6px;
                                Text { text: "أقصى احتفاظ بالصفقة (ثانية)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; }
                                LineEdit { text <=> root.sniper-hold; placeholder-text: "1 – 3600"; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 6px;
                                Text { text: "أقصى حصة تكلفة من الهدف (0.01 – 0.90)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; }
                                LineEdit { text <=> root.cost-fraction; placeholder-text: "مثال: 0.45"; }
                            }
                        }
                        Text { text: "الهدف الثابت يبقى نفسه سواء فعّلت الخروج المتعلّم أو لا. نطاق الأهداف المتعلّمة يعمل فقط مع القناص المتعلّم على Demo. إذا رفض الوسيط TP صغير بسبب Stops Level، يرفض النظام فتح تلك الصفقة بدلاً من توسيع الهدف. مدة الاحتفاظ من 1 إلى 3600 ثانية."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    background: root.theme-choice == 1 ? #ffffff : #212329; border-radius: 12px; border-width: 1px; border-color: root.theme-choice == 1 ? #e3e9f0 : #393c43;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        Text { text: "4  •  حفظ الإعدادات ومعاينة تكلفة صفقة جديدة"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 16px; font-weight: 700; }
                        Button { text: "4   حفظ إعدادات التداول"; enabled: !root.studio-busy && !root.studio-cancel-busy && root.state == "STOPPED"; clicked => { root.studio-action("save"); } }
                        Text { text: "أوقف النظام لتبديل الوضع أو التكاليف. الصفقة المفتوحة تحتفظ بهدفها ووقفها ومدتها التي جُمّدت عند الدخول."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 6px;
                                Text { text: "حجم اللوت للمعاينة فقط"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                                LineEdit { text <=> root.preview-lots; placeholder-text: "مثال: 0.10"; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 6px;
                                Text { text: "سعر MT5 اللحظي والسبريد"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; }
                                Button { text: "احسب التكلفة الحالية"; enabled: !root.studio-busy && !root.studio-cancel-busy; clicked => { root.studio-action("cost"); } }
                            }
