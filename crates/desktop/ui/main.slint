                    background: root.theme-choice==1?#e8f1f3:root.theme-choice==2?#2b333c:#142933;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.theme-choice==1?#d0e4e7:#35606a;
                    HorizontalLayout {padding:14px;spacing:14px;
                        Rectangle {width:4px;border-radius:3px;background:#28cbb7;}
                        VerticalLayout {spacing:5px;
                            Text {text:"COMMAND CENTER  /  مركز القيادة";color:root.theme-choice==1?#183849:#f0fafb;font-size:21px;font-weight:800;}
                            Text {text:"XAUUSD  •  MT5 DATA  •  LIVE EXECUTION GUARDS";color:root.theme-choice==1?#537283:#95b7c0;font-size:10px;}
                        }
