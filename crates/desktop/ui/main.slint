import { AboutSlint, Palette, ComboBox, Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
export struct NewsRow {title:string,detail:string,url:string}

component Card inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: #151f30;
    border-radius: 10px;
    min-height: 96px;
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.label; color: #8d9cb4; font-size: 13px; }
        Text { text: root.value; color: #f1f5fc; font-size: 23px; font-weight: 700; }
    }
}
export component Dashboard inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "BRAINTRADE OS | Research 0.8.0";
    preferred-width: 1120px; preferred-height: 820px; min-width: 880px; min-height: 700px;
    background: #0b1220;
    in-out property <int> page: 0;
    in property <bool> desk-busy: false;
    in property <string> desk-message;
    in-out property <bool> correlation-enabled: true;
    in-out property <string> correlation-symbols: "EURUSD, USDJPY";
    in-out property <int> correlation-frame: 1;
    in property <string> correlation-text: "بانتظار شموع الرموز من MT5";
    in-out property <string> replay-at;
    in-out property <string> replay-hours: "24";
    in property <string> replay-text: "اختر الوقت أو اتركه فارغًا لعرض المتاح حاليًا";
    in property <string> ablation-text: "تبدأ المراقبة أثناء تشغيل وضع الخبير، ثم تنتظر 12 شمعة M1 لاحقة";
    callback desk-action(string);
    in-out property <bool> exec-advanced: false;
    in-out property <bool> exec-show-ledger: false;
    in property <string> latency: "بانتظار قياس الاتصال";
    property <int> section: root.page == 0 ? 0 : (root.page == 17 || root.page == 14 || root.page == 6 || root.page == 5) ? 1 : (root.page == 4 || root.page == 10 || root.page == 12 || root.page == 16 || root.page == 8) ? 2 : (root.page == 7 || root.page == 9 || root.page == 15 || root.page == 11 || root.page == 18 || root.page == 19 || root.page == 20) ? 3 : 4;
    property <string> page-title: root.page == 18 ? "ارتباط الرموز والتعرض" : root.page == 19 ? "إعادة عرض الأخبار" : root.page == 20 ? "مساهمة العقول" : root.page == 0 ? "نظرة عامة" : root.page == 17 ? "إدارة العقول والتداول" : root.page == 14 ? "الأوضاع والعمولة" : root.page == 6 ? "الحدود الاختيارية" : root.page == 5 ? "سجل المحاكاة" : root.page == 4 ? "تحليل السوق" : root.page == 10 ? "فرص السوق" : root.page == 12 ? "خريطة المناطق" : root.page == 16 ? "وايكوف" : root.page == 8 ? "الأخبار" : root.page == 7 ? "الاختبار التاريخي" : root.page == 9 ? "التقييم الزمني" : root.page == 15 ? "مختبر الاستراتيجيات" : root.page == 11 ? "التعلم" : root.page == 1 ? "الإعدادات" : root.page == 13 ? "النسخ والاستعادة" : root.page == 2 ? "سجل النظام" : "حول التطبيق";
    function navigate(next-page: int) {
        root.page = next-page;
        if next-page == 17 { root.execution-action("refresh"); }
        if next-page == 14 { root.studio-action("config"); }
        if next-page == 15 || next-page == 16 { root.studio-action("refresh"); }
        if next-page == 9 { root.evaluation-action("refresh"); }
        if next-page == 11 { root.learning-action("refresh"); }
        if next-page == 13 { root.backup-action("refresh"); }
        if next-page == 2 { root.action("events"); }
        if next-page == 18 { root.desk-action("correlation"); }
        if next-page == 20 { root.desk-action("ablation"); }
    }
    in property <bool> execution-active: false;
    in property <bool> exec-busy: false;
    in property <[string]> exec-names;
    in-out property <int> exec-selected: 0;
    in-out property <int> exec-target: 0;
    in-out property <int> exec-frame: 0;
    in-out property <string> exec-lots: "0.01";
    in-out property <string> exec-stop: "1.5";
    in-out property <string> exec-reward: "2";
    in-out property <string> exec-hold: "1800";
    in-out property <string> exec-cooldown: "0";
    in-out property <string> exec-deviation: "20";
    in-out property <string> exec-report;
    in-out property <bool> exec-risk: false;
    in-out property <bool> portfolio-enabled: false;
    in-out property <string> portfolio-max-positions: "3";
    in-out property <string> portfolio-max-lots: "0.30";
    in-out property <string> portfolio-max-risk: "2.0";
    in property <bool> exec-enabled: false;
    in property <string> exec-role: "coordinator";
    in property <string> exec-summary: "اربط حساب Demo ثم START. العقول أعضاء افتراضياً؛ زر منفرد يغيّر عضوية العقل المختار.";
    in property <string> exec-detail;
    in property <string> exec-ledger;
    in property <string> exec-message;
    in property <[string]> exec-frames;
    callback execution-action(string);
    in-out property <int> trade-mode: 2;
    in-out property <string> sniper-target: "50";
    in-out property <string> sniper-stop: "80";
    in-out property <string> sniper-cooldown: "0";
    in-out property <string> sniper-hold: "120";
    in-out property <int> commission-basis: 0;
    in-out property <bool> commission-scoped: true;
    in-out property <string> commission-account: "null";
    in-out property <string> commission-label;
    in-out property <string> commission-context;
    in-out property <string> exec-diagnostics;
    in-out property <string> pip-points: "10";
    in-out property <string> cost-fraction: "0";
    in-out property <string> preview-lots: "0.1";
    in property <bool> studio-busy: false;
    in property <string> studio-message: "";
    in property <string> cost-detail: "7 لكل لوت × 0.1 = 0.70 من عملة الحساب. السبريد يحتاج اتصال MT5.";
    in property <string> studio-summary: "بانتظار تحميل الفريمات";
    in property <string> studio-report: "اختر نتيجة محفوظة بعد انتهاء التقييم. نحتاج 400 شمعة فعلية لكل فريم على الأقل.";
    in property <string> wyckoff-detail: "بانتظار الشموع المكتملة";
    in property <[string]> studio-frames;
    in-out property <int> studio-tf: 0;
    in property <[string]> studio-reports;
    in property <[string]> studio-ids;
    in-out property <int> studio-report-index: 0;
    callback studio-action(string);
    in property <string> state: "CONNECTING";
    in property <string> connection: "Waiting for core";
    in property <string> balance: "—";
    in property <string> equity: "—";
    in property <string> today: "—";
    in property <string> positions: "No current MT5 snapshot";
    in property <string> diagnostics: "";
    in property <string> events: "";
    in property <string> feedback: "";
    in property <string> account: "No account connected";
    in property <string> telegram-status: "Not configured";
    in property <bool> online: false;
    in property <bool> busy: false;
    in property <bool> token-saved: false;
    in-out property <string> mt5-path;
    in-out property <string> symbol: "XAUUSD";
    in-out property <string> telegram-user;
    in-out property <string> telegram-chat;
    in-out property <string> telegram-token;
    in-out property <bool> telegram-enabled: false;
    in-out property <bool> clear-token: false;
    in property <string> opportunities: "بانتظار البيانات";
    in property <string> market-map: "بانتظار البيانات";
    in property <string> opportunity-history: "اضغط عرض سجل الفرص لقراءة أول رصد محفوظ.";
    callback load-opportunity-history();
    in property <string> learning-summary: "افتح صفحة التعلم لتحديث البيانات";
    in property <string> learning-status: "لم يُحدّث بعد";
    in property <string> learning-detail: "صدّر dataset للتدريب الخارجي، ثم استورد ملف النموذج. يلزم دليل زمني متوافق قبل تسجيل المراجعة.";
    in property <string> learning-model;
    in property <bool> learning-busy: false;
    in property <bool> learning-review-ready: false;
    in-out property <string> learning-note;
    callback learning-action(string);
    in property <bool> learning-performance-ready: false;
    in property <string> learning-signature;
    in-out property <string> learning-record;
    in property <[string]> backup-names;
    in-out property <int> backup-selected: 0;
    in property <bool> backup-busy: false;
    in property <string> backup-detail: "اضغط تحديث لعرض النسخ";
    callback backup-action(string);
    in property <string> brains: "Waiting for closed M1/M5/M15 candles";
    in property <string> paper: "Virtual trades appear after START and an eligible signal";
    in property <string> regime: "UNKNOWN";
    in property <string> decision: "WAIT";
    in-out property <string> risk-percent: "0.25";
    in-out property <string> daily-limit: "2";
    in-out property <string> drawdown-limit: "5";
    in-out property <string> spread-limit: "0.25";
    in-out property <string> max-lots: "0.10";
    in-out property <string> commission-lot: "7";
    in-out property <string> risk-commission-lot: "7";
    in-out property <string> slippage-ticks: "2";
    in-out property <string> bt-from;
    in-out property <string> bt-to;
    in-out property <string> bt-equity: "10000";
    in-out property <string> bt-spread: "0.20";
    in-out property <int> bt-strategy: 0;
    in property <string> bt-status: "Waiting for core";
    in property <string> bt-report: "لا توجد نتيجة بعد. اختر فترة UTC وجلب بيانات MT5، أو افتح اختباراً محفوظاً.";
    in property <string> bt-report-id;
    in property <string> bt-net: "—";
    in property <string> bt-trades: "—";
    in property <string> bt-drawdown: "—";
    in property <[string]> bt-runs;
    in property <[string]> bt-ids;
    in-out property <int> bt-selected: -1;
    in property <bool> bt-busy: false;
    in property <bool> bt-active: false;
    callback backtest-action(string);
    in property <[string]> ev-source-runs;
    in property <[string]> ev-source-ids;
    in-out property <int> ev-source-selected: -1;
    in-out property <int> ev-plan: 0;
    in-out property <string> ev-holdout-percent: "30";
    in-out property <string> ev-development-days: "5";
    in-out property <string> ev-holdout-days: "2";
    in-out property <string> ev-step-days: "2";
    in property <string> ev-status: "Waiting for core";
    in property <string> ev-report: "لا يوجد دليل تقييم زمني معروض بعد.";
    in property <string> ev-report-id;
    in property <string> ev-v1-net: "—";
    in property <string> ev-v2-net: "—";
    in property <string> ev-delta: "—";
    in property <[string]> ev-runs;
    in property <[string]> ev-ids;
    in-out property <int> ev-selected: -1;
    in property <bool> ev-busy: false;
    in property <bool> ev-active: false;
    callback evaluation-action(string);
    in property <[NewsRow]> news-items;
    in property <string> news-status: "بانتظار المحرك";
    in property <string> news-sources;
    in property <bool> news-enabled: true;
    in property <bool> news-refreshing: false;
    in property <bool> news-empty: true;
    callback news-action(string);
    callback open-news(string);
    callback save-risk();
    callback action(string);
    callback save-settings();
    callback browse-mt5();
    HorizontalLayout {
      padding: 0px; spacing: 0px;
      Rectangle {
        width: 176px; background: #101a2a;
        VerticalLayout { padding: 16px; spacing: 12px;
            Text { text: "BRAINTRADE"; color: #f5f7fd; font-size: 19px; font-weight: 800; }
            Text { text: "مركز التداول"; color: #8d9cb4; font-size: 13px; }
            Rectangle { height: 14px; background: transparent; }
            Button { text: root.section == 0 ? "●  الرئيسية" : "الرئيسية"; clicked => { root.navigate(0); } }
            Button { text: root.section == 1 ? "●  التداول" : "التداول"; clicked => { root.navigate(17); } }
            Button { text: root.section == 2 ? "●  السوق والتحليل" : "السوق والتحليل"; clicked => { root.navigate(4); } }
            Button { text: root.section == 3 ? "●  البحث والتعلم" : "البحث والتعلم"; clicked => { root.navigate(15); } }
            Button { text: root.section == 4 ? "●  النظام" : "النظام"; clicked => { root.navigate(1); } }
            Rectangle { vertical-stretch: 1; background: transparent; }
            Text { text: root.online ? "●  MT5 متصل" : "○  انتظار MT5"; color: root.online ? #5be0be : #f0c578; }
            Text { text: "Development Preview"; color: #7f8fa7; font-size: 11px; }
        }
      }
      VerticalLayout {
        padding: 20px; spacing: 12px;
        HorizontalLayout { spacing: 12px;
            VerticalLayout { spacing: 4px;
                Text { text: root.page-title; color: #f5f7fd; font-size: 25px; font-weight: 700; }
                Text { text: root.execution-active ? "التداول فعّال على الحساب المرتبط" : "جاهز للتحليل — التداول متوقف"; color: #8d9cb4; font-size: 12px; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: root.exec-target == 0 ? "تشغيل الديمو" : "تشغيل الحقيقي"; enabled: !root.busy && !root.execution-active; clicked => { root.action(root.exec-target == 0 ? "demo/start" : "live/start"); } }
            Button { text: "إيقاف"; enabled: !root.busy; clicked => { root.action("stop"); } }
        }
        Rectangle { height: 36px; background: #151f30; border-radius: 8px;
            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                Text { text: root.state; color: root.online ? #5be0be : #f0c578; vertical-alignment: center; }
                Text { text: root.latency; color: #acbad0; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; }
            }
        }
        if root.section == 1: ComboBox {
            model: ["العقول والتداول المنفرد", "أوضاع التداول والعمولة", "الحدود الاختيارية", "سجل المحاكاة"];
            current-index: root.page == 17 ? 0 : root.page == 14 ? 1 : root.page == 6 ? 2 : 3;
            selected(value) => { root.navigate(self.current-index == 0 ? 17 : self.current-index == 1 ? 14 : self.current-index == 2 ? 6 : 5); }
        }
        if root.section == 2: ComboBox {
            model: ["تحليل السوق", "الفرص", "خريطة المناطق", "وايكوف", "الأخبار"];
            current-index: root.page == 4 ? 0 : root.page == 10 ? 1 : root.page == 12 ? 2 : root.page == 16 ? 3 : 4;
            selected(value) => { root.navigate(self.current-index == 0 ? 4 : self.current-index == 1 ? 10 : self.current-index == 2 ? 12 : self.current-index == 3 ? 16 : 8); }
        }
        if root.section == 3: ComboBox {
            model: ["مختبر الاستراتيجيات", "التعلم", "الاختبار التاريخي", "التقييم الزمني", "ارتباط الرموز", "أرشيف الأخبار", "مساهمة العقول"];
            current-index: root.page == 15 ? 0 : root.page == 11 ? 1 : root.page == 7 ? 2 : root.page == 9 ? 3 : root.page == 18 ? 4 : root.page == 19 ? 5 : 6;
            selected(value) => { root.navigate(self.current-index == 0 ? 15 : self.current-index == 1 ? 11 : self.current-index == 2 ? 7 : self.current-index == 3 ? 9 : self.current-index == 4 ? 18 : self.current-index == 5 ? 19 : 20); }
        }
        if root.section == 4: ComboBox {
            model: ["الإعدادات والاتصال", "النسخ والاستعادة", "سجل النظام", "حول التطبيق"];
            current-index: root.page == 1 ? 0 : root.page == 13 ? 1 : root.page == 2 ? 2 : 3;
            selected(value) => { root.navigate(self.current-index == 0 ? 1 : self.current-index == 1 ? 13 : self.current-index == 2 ? 2 : 3); }
        }
        if root.page == 18: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "ارتباط العوائد على أوقات متطابقة"; color: #eaf0fb; font-size: 20px; }
            Text { text: "رمز التداول الحالي يُضاف تلقائيًا. أدخل حتى 5 رموز إضافية بأسمائها الدقيقة لدى الوسيط، وافصل بينها بفاصلة. التحديث قرابة دقيقة."; color: #acbad0; wrap: word-wrap; }
            LineEdit { text <=> root.correlation-symbols; placeholder-text: "EURUSD, USDJPY"; }
            HorizontalBox {
                ComboBox { model: ["M1", "M5", "M15", "H1"]; current-index <=> root.correlation-frame; }
                CheckBox { text: "تشغيل جمع البيانات"; checked <=> root.correlation-enabled; }
                Button { text: "حفظ"; enabled: !root.desk-busy; clicked => { root.desk-action("save"); } }
                Button { text: "تحديث العرض"; enabled: !root.desk-busy; clicked => { root.desk-action("correlation-poll"); } }
            }
            Text { text: root.desk-message; color: #f0c578; wrap: word-wrap; }
            Text { text: root.correlation-text; color: #d5deed; wrap: word-wrap; }
            Text { text: "+1 تحرك متشابه و−1 متعاكس ضمن العينة. يلزم 60 عائدًا متزامنًا؛ الفراغات لا تُملأ. الارتباط وصف للعينة ولا يفتح أو يمنع صفقة."; color: #acbad0; wrap: word-wrap; }
        } }
        if root.page == 19: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "ماذا كان النظام يعرف في ذلك الوقت؟"; color: #eaf0fb; font-size: 20px; }
            Text { text: "يحفظ الأرشيف وقت وصول الخبر وتعديلات العنوان. تاريخ نشر قديم لا يجعله متاحًا للنظام قبل وصوله. يبدأ الأرشيف من تشغيل هذا التحديث."; color: #acbad0; wrap: word-wrap; }
            LineEdit { text <=> root.replay-at; placeholder-text: "2026-10-16T13:00:00+03:00 — فارغ = الآن"; }
            HorizontalBox {
                Text { text: "ساعات الرصد السابقة"; color: #acbad0; vertical-alignment: center; }
                LineEdit { text <=> root.replay-hours; }
                Button { text: "عرض المتاح وقتها"; enabled: !root.desk-busy; clicked => { root.desk-action("replay"); } }
            }
            Text { text: root.desk-message; color: #f0c578; wrap: word-wrap; }
            Text { text: root.replay-text; color: #d5deed; wrap: word-wrap; }
            Text { text: "أرشيف مصادر الأخبار الرسمية فقط؛ لا يغيّر صفقات النظام ولا يختلق أخبارًا لفترات سابقة."; color: #acbad0; wrap: word-wrap; }
        } }
        if root.page == 20: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "مقارنة المنظومة الكاملة بحذف عقل واحد"; color: #eaf0fb; font-size: 20px; }
            Text { text: "أثناء وضع الخبير تُثبت الأصوات والأوزان والأسعار والتكلفة. بعد 12 شمعة M1 مكتملة يقارن اتجاه المنظومة باتجاهها دون كل عضو، على نفس البيانات."; color: #acbad0; wrap: word-wrap; }
            Button { text: "تحديث النتائج"; enabled: !root.desk-busy; clicked => { root.desk-action("ablation"); } }
            Text { text: root.desk-message; color: #f0c578; wrap: word-wrap; }
            Text { text: root.ablation-text; color: #d5deed; wrap: word-wrap; }
        } }
        if root.page == 17: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "لكل عقل إعداداته ونتائجه"; color: #eaf0fb; font-size: 20px; }
            Text { text: root.exec-summary; color: #8ddfc6; wrap: word-wrap; }
            HorizontalBox {
                ComboBox { model: ["Demo / حساب تجريبي", "Live / أموال حقيقية"]; current-index <=> root.exec-target; }
                LineEdit { text <=> root.exec-deviation; placeholder-text: "انحراف التنفيذ بالنقاط"; }
                Button { text: root.exec-target == 0 ? "حفظ إعداد الاتصال" : "ربط الحساب الحقيقي"; enabled: !root.exec-busy && !root.execution-active; clicked => { root.execution-action("bind"); } }
            }
            Text { text: "زر تشغيل الديمو يربط حساب MT5 التجريبي الحالي ويبدأ التداول. اختر العقل لتعديل اللوت أو تفعيل التداول المنفرد."; color: #acbad0; wrap: word-wrap; }
            ComboBox { enabled: !root.exec-busy; model: root.exec-names; current-index <=> root.exec-selected; selected(value) => { root.execution-action("select"); } }
            HorizontalBox {
                Button { text: "تشغيل تداول منفرد"; enabled: !root.exec-busy && root.exec-selected != 0 && !root.exec-enabled; clicked => { root.execution-action("enable"); } }
                Button { text: "حفظ إعدادات العقل"; enabled: !root.exec-busy; clicked => { root.execution-action("save"); } }
                Button { text: "إرجاع للمنظومة"; enabled: !root.exec-busy && root.exec-selected != 0 && root.exec-enabled; clicked => { root.execution-action("disable"); } }
            }
            Text { text: root.exec-role == "coordinator" ? "العقل الرئيسي المتعلم — يتبع START/STOP والوضع المختار" : root.exec-role == "returning" ? "بانتظار الرجوع: يكمل إدارة صفقته الحالية ثم يعود تابعاً للرئيسي" : root.exec-role == "solo" ? "منفرد: مستبعد من تصويت المنظومة ويتداول بقراره" : "عضو في المنظومة: يرسل تحليله للرئيسي ولا يفتح صفقة باسمه"; color: root.exec-enabled ? #5be0be : #f0c578; wrap: word-wrap; }
            HorizontalBox {
                Text { text: "الفريم"; color: #acbad0; vertical-alignment: center; }
                ComboBox { enabled: !root.exec-busy; model: root.exec-frames; current-index <=> root.exec-frame; }
                Text { text: "اللوت الثابت"; color: #acbad0; vertical-alignment: center; }
                LineEdit { text <=> root.exec-lots; }
            }
            CheckBox { text: "عرض الإعدادات المتقدمة"; checked <=> root.exec-advanced; }
            if root.exec-advanced: VerticalBox {
