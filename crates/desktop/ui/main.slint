                        VerticalLayout {spacing:5px;
                            Text {text:root.online?"●  MT5 CONNECTED":"○  MT5 OFFLINE";color:root.online?#42d9be:#ecaa7d;font-weight:700;font-size:12px;horizontal-alignment:right;}
                            Text {text:root.execution-active?"EXECUTION ARMED":root.state=="STOPPED"?"SYSTEM STOPPED":"MONITOR ONLY";color:root.theme-choice==1?#536c7b:#d3dce4;font-size:11px;horizontal-alignment:right;}
                        }
                    }
                }
                // Four core economic metrics stay above the fold at laptop resolutions.
