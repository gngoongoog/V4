                                  color:root.online?#1bcbaa:#e6a074;font-size:12px;wrap:word-wrap;}
                            Rectangle {height:1px;background:root.theme-choice==1?#e1e8ef:#354756;}
                            Text {text:"أوضاع التداول / التنفيذ";color:root.theme-choice==1?#21374d:#dfedfa;font-weight:700;}
