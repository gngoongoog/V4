                            }
                            Text {text:"تغيير وضع التداول أو الحساب يتم من صفحات الإعدادات، مع الحفظ والتأكيد المطلوب. هذه الاختصارات لا تحول الحساب تلقائياً.";color:root.theme-choice==1?#687b90:#9aadbf;font-size:11px;wrap:word-wrap;}
                            Rectangle {height:1px;background:root.theme-choice==1?#e1e8ef:#354756;}
