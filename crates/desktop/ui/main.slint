            Text {text: "استراتيجية الاختبار الجديد / التجربة على بيانات محفوظة"; color: #d5deed;}
            ComboBox {model: ["Meta v1 — اتجاه متعدد الفريمات", "CES v1 — الانتروبيا والضغط", "KTE v1 — اندفاع وارتداد / أهداف جزئية", "Meta v2 — مرشح متعدد العقول"]; current-index <=> root.bt-strategy;}
            Text {text: root.bt-strategy == 3 ? "Meta v2: اختبار مرشح الاتجاه والبنية والزخم مع بوابات التذبذب؛ يحفظ أسباب قبول ورفض الإشارات. اختر نتيجة Meta v1 ثم تجربة الاستراتيجية للمقارنة بنفس البيانات والتكاليف." : root.bt-strategy == 0 ? "Meta v1: اتفاق اتجاه M1/M5/M15 مع تأكيد زخم أو اختراق؛ وقف 1.5 ATR وهدف 2R وحد زمني 30 دقيقة." : root.bt-strategy == 2 ? "KTE: أهداف 1R/2R/3R، وقف عند الدخول بعد TP1 وتتبع ATR بعد TP2. تقسيم اللوت 40/30/الباقي؛ يُرفض الحجم الذي لا يقبل ثلاثة أجزاء. المحاكاة المباشرة تبقى Meta." : "CES: حجم ticks؛ دخول بالافتتاح التالي، وقف 0.5 وهدف 1.5 من TR3، خروج EG موجب أو 8 دقائق. المحاكاة المباشرة تبقى Meta."; color: #acbad0; wrap: word-wrap;}
            Text { text: "BACKTEST / مختبر الاستراتيجية"; color: #eaf0fb; font-size: 20px; }
            Text { text: "فترة من يوم إلى 30 يوماً بصيغة YYYY-MM-DD وبوقت UTC؛ يوم النهاية غير مشمول. يستخدم إعدادات المخاطرة المحفوظة لحظة الطلب."; color: #acbad0; wrap: word-wrap; }
            HorizontalBox {
                Text { text: "من UTC"; color: #d5deed; }
                LineEdit { text <=> root.bt-from; placeholder-text: "2026-10-01"; }
                Text { text: "إلى UTC"; color: #d5deed; }
                LineEdit { text <=> root.bt-to; placeholder-text: "2026-10-08"; }
            }
            HorizontalBox {
                Text { text: "رأس مال افتراضي / عملة الحساب"; color: #d5deed; }
                LineEdit { text <=> root.bt-equity; }
                Text { text: "أقل سبريد / سعر الرمز"; color: #d5deed; }
                LineEdit { text <=> root.bt-spread; }
            }
            Text { text: "0.20 مثال للذهب؛ عدّل السبريد لرمزك. اضغط STOP قبل جلب التاريخ وانتظر إغلاق أي صفقة افتراضية مفتوحة."; color: #acbad0; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "جلب التاريخ وتشغيل الاختبار"; enabled: !root.bt-busy && !root.bt-active; clicked => { root.backtest-action("start"); } }
                Button { text: "إلغاء الاختبار"; enabled: !root.bt-busy && root.bt-active; clicked => { root.backtest-action("cancel"); } }
                Button { text: "تحديث القائمة"; enabled: !root.bt-busy; clicked => { root.backtest-action("refresh"); } }
            }
            Text { text: root.bt-status; color: #76dfc0; wrap: word-wrap; font-size: 14px; }
            Text { text: "اختبارات محفوظة — فتح وإعادة اختبار دون اتصال MT5"; color: #d5deed; }
            ComboBox { model: root.bt-runs; current-index <=> root.bt-selected; }
            HorizontalBox {
                Button { text: "فتح النتيجة المختارة"; enabled: !root.bt-busy && root.bt-selected >= 0; clicked => { root.backtest-action("load"); } }
                Button { text: "إعادة الاختبار بنفس البيانات"; enabled: !root.bt-busy && !root.bt-active && root.bt-selected >= 0; clicked => { root.backtest-action("replay"); } }
                Button { text: "فتح التقرير ومخطط الصفقات"; enabled: !root.bt-busy && root.bt-report-id != ""; clicked => { root.backtest-action("export"); } }
            }
            Text { text: "النتيجة المعروضة / تجربة محفوظة"; color: #d5deed; }
            Button {text: "تجربة الاستراتيجية المختارة على بيانات النتيجة المحددة"; enabled: !root.bt-busy && !root.bt-active && root.bt-selected >= 0; clicked => {root.backtest-action("experiment");}}
            Text {text: "التجربة على نتيجة محفوظة تغيّر الاستراتيجية فقط؛ رأس المال والسبريد والمخاطرة تبقى من تلك النتيجة."; color: #acbad0; wrap: word-wrap;}
            HorizontalLayout { spacing: 12px;
                Card { label: "NET / الصافي"; value: root.bt-net; }
                Card { label: "TRADES / الصفقات"; value: root.bt-trades; }
                Card { label: "MAX DRAWDOWN / التراجع"; value: root.bt-drawdown; }
            }
            Text { text: root.bt-report; color: #d5deed; wrap: word-wrap; horizontal-alignment: left; font-size: 14px; }
            Text { text: "نموذج شموع تقريبي: وقف أولاً عند لمس الوقف والهدف معاً، ولا ملء للفجوات. ليست نتيجة تنفيذ حقيقي أو اختباراً خارج العينة. التصدير يضم تقرير HTML مع منحنى الرصيد وCSV/JSON كاملين."; color: #acbad0; wrap: word-wrap; }
        } }
        if root.page == 8: ScrollView {VerticalBox {spacing: 12px;
            Text {text: "OFFICIAL NEWS / الأخبار الرسمية"; color: #eaf0fb; font-size: 20px;}
            Text {text: "عناوين من الاحتياطي الفدرالي والبنك المركزي الأوروبي. وقت الخبر UTC؛ تحديث الاتصال لا يعني أن الخبر جديد."; color: #acbad0; wrap: word-wrap;}
            HorizontalBox {
                Button {text: "تحديث الآن"; enabled: root.news-enabled && !root.news-refreshing; clicked => {root.news-action("refresh");}}
                Button {text: root.news-enabled ? "إيقاف تحديث الأخبار" : "تفعيل تحديث الأخبار"; clicked => {root.news-action(root.news-enabled ? "disable" : "enable");}}
            }
            Text {text: root.news-status; color: #76dfc0; wrap: word-wrap;}
            Text {text: root.news-sources; color: #acbad0; wrap: word-wrap; horizontal-alignment: left; font-size: 13px;}
            Text {text: "عناوين منشورة؛ ليست تقويماً للأحداث القادمة. التصنيف بالكلمات لا يحدد أثر الخبر أو اتجاه السعر، ولا يدخل في قرار Meta أو الاختبار التاريخي."; color: #f0c578; wrap: word-wrap;}
            if root.news-empty: Text {text: "لا توجد عناوين محفوظة. راجع حالة المصادر أعلاه."; color: #d5deed;}
            for item in root.news-items: Rectangle {background: #151f30; border-radius: 8px;
                VerticalLayout {padding: 14px; spacing: 8px;
                    Text {text: item.title; color: #eaf0fb; font-size: 16px; wrap: word-wrap; horizontal-alignment: left;}
                    Text {text: item.detail; color: #9dabbe; font-size: 12px; wrap: word-wrap; horizontal-alignment: left;}
                    Button {text: "فتح الخبر في موقع المصدر"; clicked => {root.open-news(item.url);}}
                }
            }
        }}
        if root.page == 9: ScrollView { VerticalBox {
            spacing: 12px;
            Text { text: "CHRONOLOGICAL EVALUATION / التقييم الزمني"; color: #eaf0fb; font-size: 20px; }
            Text { text: "يقارن Meta v1 وMeta v2 على نفس History والتكاليف ضمن نوافذ زمنية مستقلة. لا يوجد random split ولا tuning تلقائي ولا ترقية نموذج."; color: #acbad0; wrap: word-wrap; }
            Text { text: "مصدر التقييم — اختبارات Meta المحفوظة فقط"; color: #d5deed; }
            ComboBox { model: root.ev-source-runs; current-index <=> root.ev-source-selected; }
            Text { text: "خطة التقسيم"; color: #d5deed; }
            ComboBox { model: ["Holdout — development ثم جزء أخير محجوز", "Rolling — نوافذ development/holdout متتابعة"]; current-index <=> root.ev-plan; }
            if root.ev-plan == 0: HorizontalBox {
                Text { text: "نسبة Holdout %"; color: #d5deed; }
                LineEdit { text <=> root.ev-holdout-percent; placeholder-text: "30"; }
            }
            if root.ev-plan == 1: HorizontalBox {
                Text { text: "Development days"; color: #d5deed; }
                LineEdit { text <=> root.ev-development-days; }
                Text { text: "Holdout days"; color: #d5deed; }
                LineEdit { text <=> root.ev-holdout-days; }
                Text { text: "Step days"; color: #d5deed; }
                LineEdit { text <=> root.ev-step-days; }
            }
            Text { text: "كل نافذة تبدأ بدفتر صفقات ورأس مال افتراضي جديد؛ الإحماء يقرأ شموعاً أقدم فقط ولا يسمح بدخول قبل بداية النافذة."; color: #f0c578; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "تشغيل التقييم الزمني"; enabled: !root.ev-busy && !root.ev-active && root.ev-source-selected >= 0; clicked => { root.evaluation-action("start"); } }
                Button { text: "إلغاء"; enabled: !root.ev-busy && root.ev-active; clicked => { root.evaluation-action("cancel"); } }
                Button { text: "تحديث المصادر والأدلة"; enabled: !root.ev-busy; clicked => { root.evaluation-action("refresh"); } }
            }
            Text { text: root.ev-status; color: #76dfc0; wrap: word-wrap; font-size: 14px; }
            Text { text: "أدلة تقييم محفوظة immutable"; color: #d5deed; }
            ComboBox { model: root.ev-runs; current-index <=> root.ev-selected; }
            HorizontalBox {
                Button { text: "فتح الدليل المختار"; enabled: !root.ev-busy && root.ev-selected >= 0; clicked => { root.evaluation-action("load"); } }
                Button { text: "تصدير JSON + هوية المصدر"; enabled: !root.ev-busy && root.ev-selected >= 0; clicked => { root.evaluation-action("export"); } }
            }
            HorizontalLayout { spacing: 12px;
                Card { label: "META V1 NET-SUM"; value: root.ev-v1-net; }
                Card { label: "META V2 NET-SUM"; value: root.ev-v2-net; }
                Card { label: "AVG Δ NET V2−V1"; value: root.ev-delta; }
            }
            Text { text: root.ev-report; color: #d5deed; wrap: word-wrap; horizontal-alignment: left; font-size: 14px; }
            Text { text: "مهم: net-sum والمتوسطات تجمع نوافذ مستقلة وليست منحنى حساب متصل. Holdout/rolling دليل تقييم بحثي فقط، وليس إثبات ربحية ولا إذناً لـShadow أو LIVE."; color: #f0c578; wrap: word-wrap; }
        } }
        if root.page == 10: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "فرص السوق — طلب وعرض، ارتداد، اختراق وزخم"; color: #eaf0fb; font-size: 20px; wrap: word-wrap; }
            Text { text: "تتغير الخطة مع السعر، وتُسحب عند الإيقاف أو تقادم البيانات. قوة الخصائص ليست احتمال نجاح."; color: #f0c578; wrap: word-wrap; }
            Text { text: root.opportunities; color: #d5deed; wrap: word-wrap; horizontal-alignment: left; }
            Button { text: "عرض آخر 100 فرصة محفوظة"; clicked => { root.load-opportunity-history(); } }
            Text { text: root.opportunity-history; color: #acbad0; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 12: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "خريطة السوق والعقول المتخصصة"; color: #eaf0fb; font-size: 20px; }
            Text { text: "المناطق والقمم والقيعان • الزخم والتباعد • Gann • DOM • ملف نشاط ticks والجلسات"; color: #acbad0; wrap: word-wrap; }
            Text { text: root.market-map; color: #d5deed; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 11: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "التعلم والتوقعات البحثية"; color: #eaf0fb; font-size: 20px; }
            Text { text: root.learning-status; color: #76dfc0; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "تحديث"; enabled: !root.learning-busy; clicked => { root.learning-action("refresh"); } }
                Button { text: "تصدير بيانات التدريب"; enabled: !root.learning-busy; clicked => { root.learning-action("export"); } }
                Button { text: "استيراد نموذج JSON"; enabled: !root.learning-busy; clicked => { root.learning-action("register"); } }
            }
            Text { text: root.learning-summary; color: #d5deed; wrap: word-wrap; horizontal-alignment: left; }
            Text { text: "راجع هوية النموذج والدليل الزمني في التفاصيل قبل التسجيل. تسجيل الأهلية يتيح توقعات مراقبة فقط."; color: #f0c578; wrap: word-wrap; }
            LineEdit { text <=> root.learning-note; placeholder-text: "ملاحظة المراجعة (حتى 500 حرف)"; }
            Button { text: "تسجيل أهلية المراجعة الحالية"; enabled: !root.learning-busy && root.learning-review-ready; clicked => { root.learning-action("review"); } }
            HorizontalBox {
                Button { text: "تفاصيل النموذج والدليل"; enabled: !root.learning-busy; clicked => { root.learning-action("details"); } }
                Button { text: "التوقعات"; enabled: !root.learning-busy; clicked => { root.learning-action("predictions"); } }
                Button { text: "نتائج التوقعات"; enabled: !root.learning-busy; clicked => { root.learning-action("outcomes"); } }
                Button { text: "سجل المراجعات"; enabled: !root.learning-busy; clicked => { root.learning-action("records"); } }
            }
            HorizontalBox {
                Button { text: "تفاصيل أداء النموذج"; enabled: !root.learning-busy; clicked => { root.learning-action("performance"); } }
                Button { text: "حفظ مراجعة الأداء الحالية"; enabled: !root.learning-busy && root.learning-performance-ready; clicked => { root.learning-action("freeze"); } }
            }
            LineEdit { text <=> root.learning-record; placeholder-text: "معرّف مراجعة الأداء المحفوظة من السجل"; }
            Button { text: "فتح المراجعة المحفوظة"; enabled: !root.learning-busy && root.learning-record != ""; clicked => { root.learning-action("report"); } }
            Text { text: root.learning-detail; color: #acbad0; wrap: word-wrap; horizontal-alignment: left; }
        } }
        Rectangle { height: 1px; background: #263145; }
        Text { text: root.feedback; color: #f0c578; wrap: word-wrap; min-height: 22px; }
        HorizontalLayout {
            Text { text: "إغلاق النافذة يبقي المحرك شغالاً."; color: #7f8fa7; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: "خروج كامل"; enabled: !root.busy; clicked => { root.action("shutdown"); } }
        }
    }
    }
}
