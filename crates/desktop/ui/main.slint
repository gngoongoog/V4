                                for bar in root.chart-bars: Rectangle {
                                    x:10px+bar.x*(parent.width-24px);
                                    y:4px+(1.0-bar.volume)*(parent.height-8px);
                                    width:root.chart-bars.length>0?(parent.width-24px)/root.chart-bars.length*0.60:4px;
