                    Card {theme-choice:root.theme-choice;label:"BALANCE / الرصيد";value:root.balance;}
                    Card {theme-choice:root.theme-choice;label:"DAILY NET / صافي اليوم";value:root.today;}
                    Card {theme-choice:root.theme-choice;label:"FREE MARGIN / الهامش الحر";value:root.free-margin;}
                }
