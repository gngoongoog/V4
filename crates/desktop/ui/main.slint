                                Text { text: "أدنى هدف متعلّم (pip)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; }
                                LineEdit { text <=> root.sniper-min-target-pips; placeholder-text: "مثال: 2"; enabled: root.sniper-target-mode == 1 && root.trade-mode == 3 && root.sniper-brain == 1; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 6px;
                                Text { text: "أعلى هدف متعلّم (pip)"; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; }
                                LineEdit { text <=> root.sniper-max-target-pips; placeholder-text: "مثال: 10"; enabled: root.sniper-target-mode == 1 && root.trade-mode == 3 && root.sniper-brain == 1; }
                            }
                        }
