import { AboutSlint, Palette, ComboBox, Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { CorrelationPage } from "./correlation.slint";
export struct NewsRow {title:string,detail:string,url:string}
export struct ChartCandle {x:float, high-y:float, low-y:float, body-top:float, body-bottom:float, up:bool, volume:float}

component Card inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> theme-choice: 0;
    background: theme-choice == 1 ? #ffffff : theme-choice == 2 ? #292e35 : #151e2a;
    border-radius: 13px;
    border-width: 1px;
    border-color: theme-choice == 1 ? #e2e8f0 : theme-choice == 2 ? #464b53 : #273543;
    min-height: 88px;
    VerticalLayout {
        padding: 12px; spacing: 7px;
        HorizontalLayout {spacing:8px;
            Rectangle {width:3px;height:15px;border-radius:2px;background:theme-choice==1?#169e91:theme-choice==2?#5ad3bb:#35d5c6;}
            Text { text: root.label; color: theme-choice == 1 ? #526980 : #b6c0ca; font-size: 11px; font-weight: 600; }
            Rectangle {horizontal-stretch:1;background:transparent;}
        }
        Text { text: root.value; color: theme-choice == 1 ? #172235 : #f6f9ff; font-size: 24px; font-weight: 800; }
    }
}
export component Dashboard inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "BRAINTRADE V4 — Institutional Windows Terminal";
    preferred-width: 1540px; preferred-height: 920px; min-width: 960px; min-height: 700px;
    background: root.theme-choice == 1 ? #f4f7fb : root.theme-choice == 2 ? #242930 : #0c141e;
    in-out property <int> theme-choice: 0;
    in-out property <bool> compact-sidebar: false;
    in-out property <bool> expanded-workspaces: false;
    callback save-appearance(int, bool, bool);
    changed theme-choice => { Palette.color-scheme = ColorScheme.dark; }
    in property <string> account-mode-label: "NOT CONNECTED";
    in property <string> free-margin: "—";
    in property <string> active-positions: "—";
    in property <string> bid-display: "—";
    in property <string> ask-display: "—";
    in property <string> spread-display: "—";
    in property <string> quote-age-display: "—";
    in property <[ChartCandle]> chart-bars;
    in-out property <int> chart-frame: 0;
    in-out property <int> page: 0;
    in-out property <int> nav-section: 0;
    in property <bool> execution-active: false;
    in property <bool> exec-busy: false;
    in property <[string]> exec-names;
    in-out property <int> exec-selected: 0;
    in property <bool> exec-settings-loaded: false;
    in-out property <int> exec-target: 0;
    in-out property <string> exec-confirm-login: "";
    in-out property <string> live-start-login: "";
    in-out property <int> exec-frame: 0;
    in-out property <string> exec-lots: "0.01";
    in-out property <string> exec-stop: "1.5";
    in-out property <string> exec-reward: "2";
    in-out property <string> exec-hold: "1800";
    in-out property <string> exec-cooldown: "0";
    in-out property <string> exec-deviation: "20";
    in-out property <string> exec-report;
    in-out property <bool> exec-risk: false;
    in-out property <bool> portfolio-enabled: false;
    in-out property <string> portfolio-max-positions: "3";
    in-out property <string> portfolio-max-lots: "0.30";
    in-out property <string> portfolio-max-risk: "2.0";
    in property <bool> exec-enabled: false;
    in property <string> exec-role: "coordinator";
    in property <string> exec-summary: "اربط حساب Demo ثم START. العقل الرئيسي للوضع المختار فقط ينفذ؛ بقية العقول SHADOW/PAPER.";
    in property <string> exec-detail;
    in property <string> exec-ledger;
    in property <string> exec-shadow: "التدريب الافتراضي: بانتظار أسعار حديثة";
    in property <[string]> trade-journal-rows;
    in-out property <int> trade-journal-selected: -1;
    in property <string> trade-journal-summary: "حمّل سجل الصفقات من MT5";
    in property <string> trade-journal-detail: "اختر صفقة لعرض كامل تفاصيلها";
    in property <string> trade-journal-notice: "السجل يُقرأ من صفقات الوسيط المحفوظة، ولا يخلط نتائج PAPER أو SHADOW";
    in property <bool> trade-journal-busy: false;
    in property <bool> trade-journal-has-prev: false;
    in property <bool> trade-journal-has-next: false;
    callback trade-journal-action(string);
    in property <string> exec-message;
    in property <[string]> exec-frames;
    callback execution-action(string);
    in property <bool> student-busy: false;
    in property <string> student-status: "بانتظار سجل التعلّم";
    in property <string> student-total: "0";
    in property <string> student-closed: "0";
    in property <string> student-pairs: "0";
    in property <string> student-patterns;
    in property <string> student-policies;
    in property <string> student-journal;
    in property <string> student-timing;
    in-out property <int> trade-mode: 2;
    in-out property <int> sniper-brain: 0;
    in-out property <int> sniper-style: 0;
    in property <[string]> brain-monitor-names;
    in-out property <int> brain-monitor-selected: 0;
    in property <bool> brain-monitor-busy: false;
    in property <bool> brain-monitor-available: false;
    in-out property <bool> brain-advisor: true;
    in-out property <bool> brain-paper: true;
    in property <string> brain-monitor-summary: "بانتظار اتصال الحساب";
    in property <string> brain-monitor-overview;
    in property <string> brain-monitor-detail;
    in property <string> brain-monitor-message;
    in property <bool> frozen-trial-available: false;
    callback brain-monitor-action(string);
    in-out property <int> sniper-target-mode: 0;
    in-out property <string> sniper-min-target-pips: "2";
    in-out property <string> sniper-max-target-pips: "10";
    in-out property <bool> demo-flexible: true;
    in-out property <bool> adaptive-exits: true;
    in-out property <string> sniper-target: "5";
    in-out property <string> sniper-stop: "80";
    in-out property <string> sniper-cooldown: "0";
    in-out property <string> sniper-hold: "120";
    in-out property <string> pip-points: "10";
    in-out property <string> sniper-pip-price: "0.10";
    in-out property <string> cost-fraction: "0.45";
    in-out property <string> preview-lots: "0.1";
    in property <bool> studio-busy: false;
    in property <bool> studio-cancel-busy: false;
    in property <string> studio-message: "";
    in property <string> cost-detail: "العمولة الافتراضية: 0.10 لوت = 0.70 و0.01 لوت = 0.07 من عملة الحساب. اربط MT5 واضغط «احسب» لعرض السبريد والتعادل من الأسعار الحقيقية.";
    in property <string> studio-summary: "بانتظار تحميل الفريمات";
    in property <string> studio-report: "اختر نتيجة محفوظة بعد انتهاء التقييم. نحتاج 400 شمعة فعلية لكل فريم على الأقل.";
    in property <string> wyckoff-detail: "بانتظار الشموع المكتملة";
    in property <[string]> studio-frames;
    in-out property <int> studio-tf: 0;
    in property <[string]> studio-reports;
    in property <[string]> studio-ids;
    in-out property <int> studio-report-index: 0;
    callback studio-action(string);
    in property <string> state: "CONNECTING";
    in property <string> connection: "Waiting for core";
    in property <string> balance: "—";
    in property <string> equity: "—";
    in property <string> broker-leverage: "—";
    in-out property <string> scenario-leverage: "500";
    in property <string> leverage-note: "الرافعة الافتراضية للتخطيط فقط؛ الهامش الفعلي يحسبه وسيط MT5.";
    in property <string> today: "—";
    in property <string> positions: "No current MT5 snapshot";
    in property <string> diagnostics: "";
    in property <string> events: "";
    in property <string> feedback: "";
    in property <string> account: "No account connected";
    in property <string> telegram-status: "Not configured";
    in property <bool> online: false;
    in property <bool> busy: false;
    in property <bool> token-saved: false;
    in-out property <string> mt5-path;
    in-out property <string> symbol: "XAUUSD";
    in-out property <string> telegram-user;
    in-out property <string> telegram-chat;
    in-out property <string> telegram-token;
    in-out property <bool> telegram-enabled: false;
    in-out property <bool> clear-token: false;
    in property <string> opportunities: "بانتظار البيانات";
    in property <string> market-map: "بانتظار البيانات";
    in property <string> opportunity-history: "اضغط عرض سجل الفرص لقراءة أول رصد محفوظ.";
    callback load-opportunity-history();
    in property <string> learning-summary: "افتح صفحة التعلم لتحديث البيانات";
    in property <string> learning-status: "لم يُحدّث بعد";
    in property <string> learning-detail: "صدّر dataset للتدريب الخارجي، ثم استورد ملف النموذج. يلزم دليل زمني متوافق قبل تسجيل المراجعة.";
    in property <string> learning-model;
    in property <bool> learning-busy: false;
    in property <bool> learning-review-ready: false;
    in-out property <string> learning-note;
    callback learning-action(string);
    in property <bool> learning-performance-ready: false;
    in property <string> learning-signature;
    in-out property <string> learning-record;
    in property <[string]> backup-names;
    in-out property <int> backup-selected: 0;
    in property <bool> backup-busy: false;
    in property <string> backup-detail: "اضغط تحديث لعرض النسخ";
    callback backup-action(string);
    in property <string> brains: "Waiting for closed M1/M5/M15 candles";
    in property <string> paper: "Virtual trades appear after START and an eligible signal";
    in property <string> regime: "UNKNOWN";
    in property <string> decision: "WAIT";
    in-out property <string> risk-percent: "0.25";
    in-out property <bool> micro-demo-risk-opt-in: false;
    in-out property <bool> micro-real-temporary: false;
    in-out property <string> micro-real-recovery-equity: "500";
    in-out property <string> micro-real-cap-percent: "10";
    in-out property <string> daily-limit: "2";
    in-out property <bool> daily-breaker-demo-enabled: false;
    in-out property <bool> daily-breaker-real-enabled: true;
    in property <bool> risk-monitor-busy: false;
    in property <string> risk-monitor-text: "حالة القاطع: بانتظار قراءة MT5. هذه شاشة مراقبة، وليست موافقة إرسال أوامر.";
    callback risk-monitor-refresh();
    in-out property <string> drawdown-limit: "5";
    in-out property <string> spread-limit: "0.25";
    in-out property <string> max-lots: "0.10";
    in-out property <string> commission-lot: "7";
    // Independent round-trip Risk editor: Trading may show per-side commission.
    in-out property <string> risk-commission-lot: "7";
    in-out property <int> commission-basis: 0;
    in-out property <string> slippage-ticks: "2";
    in-out property <string> bt-from;
    in-out property <string> bt-to;
    in-out property <string> bt-equity: "10000";
    in-out property <string> bt-spread: "0.20";
    in-out property <int> bt-strategy: 0;
    in property <string> bt-status: "Waiting for core";
    in property <string> bt-report: "لا توجد نتيجة بعد. اختر فترة UTC وجلب بيانات MT5، أو افتح اختباراً محفوظاً.";
    in property <string> bt-report-id;
    in property <string> bt-net: "—";
    in property <string> bt-trades: "—";
    in property <string> bt-drawdown: "—";
    in property <[string]> bt-runs;
    in property <[string]> bt-ids;
    in-out property <int> bt-selected: -1;
    in property <bool> bt-busy: false;
    in property <bool> bt-active: false;
    callback backtest-action(string);
    in property <[string]> ev-source-runs;
    in property <[string]> ev-source-ids;
    in-out property <int> ev-source-selected: -1;
    in-out property <int> ev-plan: 0;
    in-out property <string> ev-holdout-percent: "30";
    in-out property <string> ev-development-days: "5";
    in-out property <string> ev-holdout-days: "2";
    in-out property <string> ev-step-days: "2";
    in property <string> ev-status: "Waiting for core";
    in property <string> ev-report: "لا يوجد دليل تقييم زمني معروض بعد.";
    in property <string> ev-report-id;
    in property <string> ev-v1-net: "—";
    in property <string> ev-v2-net: "—";
    in property <string> ev-delta: "—";
    in property <[string]> ev-runs;
    in property <[string]> ev-ids;
    in-out property <int> ev-selected: -1;
    in property <bool> ev-busy: false;
    in property <bool> ev-active: false;
    callback evaluation-action(string);
    in property <[NewsRow]> news-items;
    in property <string> news-status: "بانتظار المحرك";
    in property <string> news-sources;
    in property <bool> news-enabled: true;
    in property <bool> news-refreshing: false;
    in property <bool> news-empty: true;
    callback news-action(string);
    callback open-news(string);
    in property <[string]> corr-sources;
    in property <[string]> corr-source-ids;
    in-out property <int> corr-source-a: -1;
    in-out property <int> corr-source-b: -1;
    in-out property <int> corr-source-c: -1;
    in-out property <int> corr-source-d: -1;
    in-out property <int> corr-source-e: -1;
    in-out property <int> corr-source-f: -1;
    in-out property <int> corr-source-g: -1;
    in-out property <int> corr-source-h: -1;
    in-out property <string> corr-min-overlap: "30";
    in property <[string]> corr-reports;
    in property <[string]> corr-report-ids;
    in-out property <int> corr-report-selected: -1;
    in property <bool> corr-busy: false;
    in property <string> corr-status: "اضغط تحديث لتحميل نتائج Backtest المحفوظة";
    in property <string> corr-title: "لا يوجد تقرير correlation معروض";
    in property <string> corr-matrix: "اختر مصدرين على الأقل ثم شغّل التحليل.";
    in property <string> corr-portfolio: "";
    in property <string> corr-provenance: "";
    in property <string> corr-boundary: "RESEARCH ONLY — لا تأثير على أوامر MT5 أو Portfolio Exposure.";
    callback correlation-action(string);
    callback save-risk();
    callback action(string);
    callback save-settings();
    callback browse-mt5();
    HorizontalLayout {
        padding: 0px; spacing: 0px;
        Rectangle {
            width: root.compact-sidebar ? 70px : 204px;
            background: root.theme-choice == 1 ? #ffffff : root.theme-choice == 2 ? #292e35 : #101a26;
            border-width: 1px; border-color: root.theme-choice == 1 ? #e4e9f0 : #263543;
            VerticalLayout {
                padding: 9px; spacing: 6px;
                Rectangle { height: 85px; background: transparent;
                    HorizontalLayout { padding: 7px;spacing:10px;
                        Rectangle {width:5px;border-radius:3px;background:#3ad2bc;}
                        VerticalLayout {spacing:4px;
                            Text { text: root.compact-sidebar ? "BT" : "BRAINTRADE"; color: root.theme-choice == 1 ? #172d3d : #edf7fa; font-size: root.compact-sidebar ? 17px : 20px; font-weight: 800; }
                            Text { text: root.compact-sidebar ? "V4" : "V4  /  TRADING DESK"; color: root.theme-choice == 1 ? #4b8090 : #83d7cc; font-size: 11px; font-weight: 600; }
                        }
                    }
                }
                Button {text:root.compact-sidebar?"☰":"☰  طي القائمة";clicked=>{root.compact-sidebar=!root.compact-sidebar;root.save-appearance(root.theme-choice,root.compact-sidebar,root.expanded-workspaces);}}
                Rectangle {height:1px; background:root.theme-choice == 1 ? #e2e8f0 : #304052;}
                Text {text: root.compact-sidebar ? "•" : "MAIN WORKSPACE"; color: root.theme-choice==1?#74889a:#7e9cab;font-size:10px;horizontal-alignment:center;}
                Button { text: root.compact-sidebar ? (root.page == 0 ? "●" : "⌂") : (root.page == 0 ? "●   نظرة عامة" : "⌂   نظرة عامة"); clicked => {root.nav-section=0;root.page=0;} }
                Button { text: root.compact-sidebar ? (root.page == 14 ? "●" : "↗") : (root.page == 14 ? "●   مركز التداول" : "↗   مركز التداول"); clicked => {root.nav-section=1;root.page=14;root.studio-action("config");} }
                Button { text: root.compact-sidebar ? "◎" : "◎   وضع القناص"; clicked => {root.nav-section=1;root.page=14;root.studio-action("config");} }
                Button { text: root.compact-sidebar ? (root.page == 21 ? "●" : "✦") : (root.page == 21 ? "●   العقول" : "✦   العقول"); clicked => {root.nav-section=2;root.page=21;root.brain-monitor-action("refresh");} }
                Button { text: root.compact-sidebar ? (root.page == 6 ? "●" : "◇") : (root.page == 6 ? "●   إدارة المخاطر" : "◇   إدارة المخاطر"); clicked => {root.nav-section=1;root.page=6;root.risk-monitor-refresh();} }
                Button { text: root.compact-sidebar ? (root.page == 17 ? "●" : "⇄") : (root.page == 17 ? "●   التنفيذ MT5" : "⇄   التنفيذ MT5"); clicked => {root.nav-section=1;root.page=17;root.execution-action("refresh");} }
                Button { text: root.compact-sidebar ? (root.page == 4 ? "●" : "▤") : (root.page == 4 ? "●   التحليلات" : "▤   التحليلات"); clicked => {root.nav-section=2;root.page=4;} }
                Button { text: root.compact-sidebar ? (root.page == 20 ? "●" : "▣") : (root.page == 20 ? "●   سجل الصفقات" : "▣   سجل الصفقات"); clicked => {root.nav-section=1;root.page=20;root.trade-journal-action("refresh");} }
                Button { text: root.compact-sidebar ? (root.page == 19 ? "●" : "◴") : (root.page == 19 ? "●   تقدّم التعلّم" : "◴   تقدّم التعلّم"); clicked => {root.nav-section=1;root.page=19;} }
                Button { text: root.compact-sidebar ? "✉" : "✉   Telegram"; clicked => {root.nav-section=4;root.page=1;} }
                Button { text: root.compact-sidebar ? (root.page == 2 ? "●" : "≡") : (root.page == 2 ? "●   سجل النظام" : "≡   سجل النظام"); clicked => {root.nav-section=4;root.page=2;root.action("events");} }
                Button { text: root.compact-sidebar ? "⚙" : "⚙   الإعدادات"; clicked => {root.nav-section=4;root.page=1;} }
                Rectangle { vertical-stretch:1; background:transparent; }
                Text { text: root.compact-sidebar ? "V4" : "Windows 0.7.4 • Rust / Slint"; color: root.theme-choice == 1 ? #7d8ba1 : #93a8bc; font-size:10px; horizontal-alignment:center; }
                Text { text: root.online ? (root.compact-sidebar ? "●" : "●  MT5 ONLINE") : (root.compact-sidebar ? "○" : "○  MT5 OFFLINE"); color: root.online ? #18c9a7 : #d99870; font-size:12px; horizontal-alignment:center; }
            }
        }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            // Operational status stays visible on all 22 native pages.
        Rectangle {
            height: 62px;
            background: root.theme-choice == 1 ? #ffffff : root.theme-choice == 2 ? #313740 : #152230;
            border-radius: 13px;
            border-width: 1px; border-color: root.theme-choice == 1 ? #dfe6ef : #2e4052;
            HorizontalLayout {
                padding: 12px; spacing: 14px;
                VerticalLayout {spacing: 3px;
                    Text {text: "BROKER / ACCOUNT"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size: 10px;}
                    Text {text: root.online ? root.account : "MT5 • غير متصل"; color: root.theme-choice == 1 ? #17273b : #f2f7fb; font-weight: 700; font-size: 12px; }
                }
                Rectangle { width: 1px; background: root.theme-choice == 1 ? #dfe6ef : #344657; }
                VerticalLayout {spacing:3px;
                    Text {text: "ACCOUNT MODE"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size:10px;}
                    Text {text: root.account-mode-label; color: root.online ? (root.account-mode-label == "REAL" ? #f1ab73 : #1cc8a9) : #a4afbc; font-weight:700;}
                }
                Rectangle {horizontal-stretch: 1; background: transparent;}
                VerticalLayout {spacing:3px; visible: root.width >= 1100px;
                    Text {text: "EQUITY"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size:10px;}
                    Text {text: root.equity; color: root.theme-choice == 1 ? #14273c : #f2f7fb; font-weight:700;}
                }
                VerticalLayout {spacing:3px; visible: root.width >= 1250px;
                    Text {text: "BALANCE"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size:10px;}
                    Text {text: root.balance; color: root.theme-choice == 1 ? #14273c : #f2f7fb; font-weight:700;}
                }
                VerticalLayout {spacing:3px; visible: root.width >= 1400px;
                    Text {text: "DAILY NET"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size:10px;}
                    Text {text: root.today; color: root.theme-choice == 1 ? #187b69 : #3ce3b8; font-weight:700;}
                }
                Rectangle {width:1px; background: root.theme-choice == 1 ? #dfe6ef : #344657;}
                VerticalLayout {spacing:3px;
                    Text {text: "APPEARANCE"; color: root.theme-choice == 1 ? #65758a : #92a9bd; font-size:10px;}
                    HorizontalLayout {spacing:4px;
                        Button { text:"داكن"; clicked => {root.theme-choice=0; root.save-appearance(root.theme-choice,root.compact-sidebar,root.expanded-workspaces);} }
                        Button { text:"أبيض"; clicked => {root.theme-choice=1; root.save-appearance(root.theme-choice,root.compact-sidebar,root.expanded-workspaces);} }
                        Button { text:"رمادي"; clicked => {root.theme-choice=2; root.save-appearance(root.theme-choice,root.compact-sidebar,root.expanded-workspaces);} }
                    }
                }
            }
        }
        Rectangle {
            min-height: 36px;
            background: root.theme-choice == 1 ? (root.execution-active ? #dff5ee : #e9eff6) : root.execution-active ? #303239 : #22242a;
            border-radius: 11px;
            border-width: 1px; border-color: root.theme-choice == 1 ? #e3e9f0 : #3b3d45;
            HorizontalLayout { padding-left: 15px; padding-right: 15px; spacing: 10px;
                Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.execution-active ? (root.theme-choice == 1 ? #168e78 : #edf0f4) : (root.theme-choice == 1 ? #77879b : #868a94); }
                Text {
                    text: root.execution-active ? "تنفيذ MT5 مفعّل — أوامر الوسيط تتبع START / STOP"
                                                : "وضع المراقبة — اربط حساب Demo وراجع الإعدادات قبل تشغيل التنفيذ";
                    color: root.theme-choice == 1 ? #28384b : #e0e1e4; vertical-alignment: center; wrap: word-wrap;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.online ? "CONNECTED" : "OFFLINE"; color: root.theme-choice == 1 ? #62758b : #aeb1ba; font-size: 11px; vertical-alignment: center; visible: root.width >= 1100px; }
            }
        }
        HorizontalLayout {
            spacing: 9px;
            Button { text: "بدء النظام  START"; enabled: !root.busy && root.state == "STOPPED"; clicked => { root.action("start"); } }
            Button { text: "إيقاف  STOP"; enabled: !root.busy && root.state != "STOPPED"; clicked => { root.action("stop"); } }
            Button { text: "إعادة اتصال MT5"; enabled: !root.busy; clicked => { root.action("reconnect"); } }
            Button { text: root.expanded-workspaces ? "−  إخفاء الأقسام" : "+  جميع الصفحات"; clicked => {root.expanded-workspaces = !root.expanded-workspaces;root.save-appearance(root.theme-choice,root.compact-sidebar,root.expanded-workspaces);} }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.decision; color: root.theme-choice == 1 ? #28384b : #d9dbe0; vertical-alignment: center; font-weight: 600; }
        }
        if root.account-mode-label == "REAL": HorizontalLayout {
            spacing: 9px;
            Text { text: "لـ REAL فقط: اكتب رقم حساب MT5 الحقيقي قبل كل START"; color: root.theme-choice == 1 ? #82533c : #e5dad3; vertical-alignment: center; }
            LineEdit { text <=> root.live-start-login; placeholder-text: "رقم حساب REAL للتأكيد"; }
        }
        Rectangle {
            background: root.theme-choice == 1 ? #f8fbfe : #1b1d22; border-radius: 14px;
            border-width: 1px; border-color: root.theme-choice == 1 ? #e3e9f0 : #34363d;
            height: root.expanded-workspaces ? (root.nav-section == 2 ? 123px : 88px) : 0px;
            visible: root.expanded-workspaces;
            VerticalLayout {
                padding: 8px; spacing: 5px;
                HorizontalLayout {
                    height: 34px; spacing: 9px;
                    Button { text: root.nav-section == 0 ? "●  الرئيسية" : "الرئيسية"; clicked => { root.nav-section = 0; root.page = 0; } }
                    Button { text: root.nav-section == 1 ? "●  التداول" : "التداول"; clicked => { root.nav-section = 1; root.page = 14; root.studio-action("config"); } }
                    Button { text: root.nav-section == 2 ? "●  التحليل" : "التحليل"; clicked => { root.nav-section = 2; root.page = 4; } }
                    Button { text: root.nav-section == 3 ? "●  المختبر" : "المختبر"; clicked => { root.nav-section = 3; root.page = 7; root.backtest-action("refresh"); } }
                    Button { text: root.nav-section == 4 ? "●  الإعدادات" : "الإعدادات"; clicked => { root.nav-section = 4; root.page = 1; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "اختر قسماً، ثم الصفحة المطلوبة"; color: root.theme-choice == 1 ? #62758b : #92969f; font-size: 12px; vertical-alignment: center; }
                }
                Rectangle { height: 1px; background: root.theme-choice == 1 ? #e3e9f0 : #34363d; }
                if root.nav-section == 0: HorizontalLayout {
                    height: 33px; spacing: 8px;
                    Text { text: "نظرة سريعة على الحساب والاتصال والصفقات المفتوحة"; color: root.theme-choice == 1 ? #62758b : #aeb1ba; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "تهيئة MT5"; clicked => { root.nav-section = 4; root.page = 1; } }
                    Button { text: "إعداد التداول"; clicked => { root.nav-section = 1; root.page = 14; root.studio-action("config"); } }
                }
                if root.nav-section == 1: HorizontalLayout {
                    height: 33px; spacing: 8px;
                    Button { text: root.page == 14 ? "●  الأوضاع والتكاليف" : "الأوضاع والتكاليف"; clicked => { root.page = 14; root.studio-action("config"); } }
                    Button { text: root.page == 17 ? "●  تنفيذ MT5" : "تنفيذ MT5"; clicked => { root.page = 17; root.execution-action("refresh"); } }
                    Button { text: root.page == 20 ? "●  سجل الصفقات" : "سجل الصفقات"; clicked => { root.page = 20; root.trade-journal-action("refresh"); } }
                    Button { text: root.page == 19 ? "●  تقدّم التعلّم" : "تقدّم التعلّم"; clicked => { root.page = 19; } }
                    Button { text: root.page == 6 ? "●  المخاطرة" : "المخاطرة"; clicked => { root.page = 6; root.risk-monitor-refresh(); } }
                }
                if root.nav-section == 2: VerticalLayout {
                    height: 70px; spacing: 5px;
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Button { text: root.page == 4 ? "●  العقول" : "العقول"; clicked => { root.page = 4; } }
                        Button { text: root.page == 10 ? "●  فرص السوق" : "فرص السوق"; clicked => { root.page = 10; } }
                        Button { text: root.page == 12 ? "●  خريطة السوق" : "خريطة السوق"; clicked => { root.page = 12; } }
                        Button { text: root.page == 16 ? "●  وايكوف" : "وايكوف"; clicked => { root.page = 16; root.studio-action("refresh"); } }
                    }
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Button { text: "حالة العقول والتحكم"; clicked => { root.page = 21; root.brain-monitor-action("refresh"); } }
                        Button { text: root.page == 8 ? "●  الأخبار" : "الأخبار"; clicked => { root.page = 8; } }
                        Button { text: root.page == 11 ? "●  نماذج البحث" : "نماذج البحث"; clicked => { root.page = 11; root.learning-action("refresh"); } }
                        Button { text: root.page == 18 ? "●  الارتباط" : "الارتباط"; enabled: !root.corr-busy; clicked => { root.page = 18; root.correlation-action("refresh"); } }
                    }
                }
                if root.nav-section == 3: HorizontalLayout {
                    height: 33px; spacing: 8px;
                    Button { text: root.page == 5 ? "●  المحاكاة" : "المحاكاة"; clicked => { root.page = 5; } }
                    Button { text: root.page == 7 ? "●  Backtest" : "Backtest"; clicked => { root.page = 7; root.backtest-action("refresh"); } }
                    Button { text: root.page == 9 ? "●  التقييم الزمني" : "التقييم الزمني"; clicked => { root.page = 9; root.evaluation-action("refresh"); } }
                    Button { text: root.page == 15 ? "●  مختبر الاستراتيجيات" : "مختبر الاستراتيجيات"; clicked => { root.page = 15; root.studio-action("refresh"); } }
                }
                if root.nav-section == 4: HorizontalLayout {
                    height: 33px; spacing: 8px;
                    Button { text: root.page == 1 ? "●  MT5 وTelegram" : "MT5 وTelegram"; clicked => { root.page = 1; } }
                    Button { text: root.page == 2 ? "●  السجل" : "السجل"; clicked => { root.page = 2; root.action("events"); } }
                    Button { text: root.page == 13 ? "●  النسخ الاحتياطي" : "النسخ الاحتياطي"; enabled: !root.backup-busy; clicked => { root.page = 13; root.backup-action("refresh"); } }
                    Button { text: root.page == 3 ? "●  حول النظام" : "حول النظام"; clicked => { root.page = 3; } }
                }
            }
        }
        // Page context explains whether a screen controls the broker or only research.
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.page == 0 ? "نظرة عامة"
                    : root.page == 1 ? "MT5 وTelegram"
                    : root.page == 2 ? "سجلات النظام"
                    : root.page == 3 ? "حول النظام"
                    : root.page == 4 ? "التحليل والعقول"
                    : root.page == 5 ? "المحاكاة"
                    : root.page == 6 ? "إدارة المخاطر"
                    : root.page == 7 ? "الاختبارات التاريخية"
                    : root.page == 8 ? "الأخبار الرسمية"
                    : root.page == 9 ? "التقييم الزمني"
                    : root.page == 10 ? "فرص السوق"
                    : root.page == 11 ? "نماذج التعلم"
                    : root.page == 12 ? "خريطة السوق"
                    : root.page == 13 ? "النسخ الاحتياطي"
                    : root.page == 14 ? "مركز التداول والقناص"
                    : root.page == 15 ? "مختبر الاستراتيجيات"
                    : root.page == 16 ? "مراحل وايكوف"
                    : root.page == 17 ? "التنفيذ والأوامر"
                    : root.page == 18 ? "تحليل الارتباط"
                    : root.page == 19 ? "نتائج التعلم"
                    : root.page == 20 ? "سجل صفقات MT5"
                    : root.page == 21 ? "غرفة العقول والتحكم"
                    : "واجهة نظام V4";
                color: root.theme-choice == 1 ? #17283d : #f0f0f2; font-weight: 700; font-size: 15px;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            // Only pages with real existing Core-backed refresh handlers are enabled.
            Button {
                text: "↻ تحديث الصفحة";
                enabled: !root.busy && !root.studio-busy && !root.exec-busy
                    && !root.trade-journal-busy && !root.brain-monitor-busy
                    && !root.risk-monitor-busy && !root.bt-busy && !root.ev-busy
                    && !root.learning-busy && !root.backup-busy && !root.corr-busy
                    && !root.news-refreshing && (
                    root.page == 2 || root.page == 6 || root.page == 7
                    || root.page == 8 || root.page == 9 || root.page == 11
                    || root.page == 13 || root.page == 14 || root.page == 15
                    || root.page == 16 || root.page == 17 || root.page == 18
                    || root.page == 20 || root.page == 21);
                clicked => {
                    if (root.page == 2) {root.action("events");}
                    if (root.page == 6) {root.risk-monitor-refresh();}
                    if (root.page == 7) {root.backtest-action("refresh");}
                    if (root.page == 8) {root.news-action("refresh");}
                    if (root.page == 9) {root.evaluation-action("refresh");}
                    if (root.page == 11) {root.learning-action("refresh");}
                    if (root.page == 13) {root.backup-action("refresh");}
                    if (root.page == 14) {root.studio-action("config");}
                    if (root.page == 15 || root.page == 16) {root.studio-action("refresh");}
                    if (root.page == 17) {root.execution-action("refresh");}
                    if (root.page == 18) {root.correlation-action("refresh");}
                    if (root.page == 20) {root.trade-journal-action("refresh");}
                    if (root.page == 21) {root.brain-monitor-action("refresh");}
                }
            }
            ComboBox {
                model: ["نظرة عامة","MT5 وTelegram","سجلات النظام","حول النظام",
                    "التحليل والعقول","المحاكاة","إدارة المخاطر","الاختبارات التاريخية",
                    "الأخبار الرسمية","التقييم الزمني","فرص السوق","نماذج التعلم",
                    "خريطة السوق","النسخ الاحتياطي","مركز التداول والقناص",
                    "مختبر الاستراتيجيات","مراحل وايكوف","التنفيذ والأوامر",
                    "تحليل الارتباط","نتائج التعلم","سجل صفقات MT5","غرفة العقول"];
                current-index <=> root.page;
                selected(value) => {
                    root.nav-section = root.page == 0 ? 0
                        : root.page == 6 || root.page == 14 || root.page == 17 || root.page == 19 || root.page == 20 ? 1
                        : root.page == 4 || root.page == 8 || root.page == 10 || root.page == 11 || root.page == 12 || root.page == 16 || root.page == 18 || root.page == 21 ? 2
                        : root.page == 5 || root.page == 7 || root.page == 9 || root.page == 15 ? 3 : 4;
                    if (root.page == 14 || root.page == 16 || root.page == 15) {root.studio-action(root.page == 14 ? "config" : "refresh");}
                    if (root.page == 17) {root.execution-action("refresh");}
                    if (root.page == 20) {root.trade-journal-action("refresh");}
                    if (root.page == 21) {root.brain-monitor-action("refresh");}
                    if (root.page == 6) {root.risk-monitor-refresh();}
                    if (root.page == 7) {root.backtest-action("refresh");}
                    if (root.page == 9) {root.evaluation-action("refresh");}
                    if (root.page == 11) {root.learning-action("refresh");}
                    if (root.page == 13) {root.backup-action("refresh");}
                    if (root.page == 18) {root.correlation-action("refresh");}
                    if (root.page == 2) {root.action("events");}
                }
            }
        }
        if root.page == 18: CorrelationPage {
            vertical-stretch: 1;
            theme-choice: root.theme-choice;
            sources: root.corr-sources;
            source-a <=> root.corr-source-a;
            source-b <=> root.corr-source-b;
            source-c <=> root.corr-source-c;
            source-d <=> root.corr-source-d;
            source-e <=> root.corr-source-e;
            source-f <=> root.corr-source-f;
            source-g <=> root.corr-source-g;
            source-h <=> root.corr-source-h;
            min-overlap <=> root.corr-min-overlap;
            reports: root.corr-reports;
            report-selected <=> root.corr-report-selected;
            busy: root.corr-busy;
            status: root.corr-status;
            title: root.corr-title;
            matrix: root.corr-matrix;
            portfolio: root.corr-portfolio;
            provenance: root.corr-provenance;
            boundary: root.corr-boundary;
            action(value) => { root.correlation-action(value); }
        }
        if root.page == 19: ScrollView { VerticalBox { spacing: 14px;
            Text { text: "تقدّم التعلّم  /  نتائج حقيقية وتجارب بحثية"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 22px; font-weight: 700; }
            Text { text: root.student-status; color: root.theme-choice == 1 ? #3b4b60 : #d7dadf; wrap: word-wrap; }
            HorizontalBox { spacing: 10px;
                Card { theme-choice: root.theme-choice; label: "تجارب دخول مسجّلة"; value: root.student-total; }
                Card { theme-choice: root.theme-choice; label: "صفقات MT5 مغلقة"; value: root.student-closed; }
                Card { theme-choice: root.theme-choice; label: "مقارنات دخلت التعلّم"; value: root.student-pairs; }
            }
            Text { text: "شنو يتكرر بالنتائج؟"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 18px; font-weight: 700; }
            Text { text: "آخر 100 تجربة كحد أقصى. هذه أنماط مرصودة؛ سبب الخسارة قد يحتاج أدلة إضافية."; color: root.theme-choice == 1 ? #62758b : #999ca5; wrap: word-wrap; }
            Text { text: root.student-patterns; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            Text { text: "شنو تغيّر بالخروج؟"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 18px; font-weight: 700; }
            Text { text: root.student-policies; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: "20 مقارنة للتدريب، ثم 20 دخولاً جديداً لاختبار البديل. الإعداد الأصلي يبقى يعمل خلال التعلّم. التطبيق الآلي للديمو فقط؛ تغييره من صفحة الوضع والتكلفة."; color: root.theme-choice == 1 ? #62758b : #999ca5; wrap: word-wrap; }
            Text { text: "توقيت الدخول — مقارنة افتراضية"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 18px; font-weight: 700; }
            Text { text: "فور الإشارة، بعد 250 ms، أو بعد 1000 ms. مقارنة على أسعار لاحقة بنفس المهلة والتكاليف، ولا تؤخّر إرسال الأوامر. الرصد البطيء يُستبعد بدل تخمين الأسعار."; color: root.theme-choice == 1 ? #62758b : #999ca5; wrap: word-wrap; }
            Text { text: root.student-timing; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: "دفتر التجارب — أحدث 20 دخولاً"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 18px; font-weight: 700; }
            Text { text: root.student-journal; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: "MFE / MAE: أفضل وأسوأ حركة مرصودة بعد تأكيد التنفيذ وحتى الإغلاق. المقارنة الافتراضية تستخدم Bid/Ask والعمولة والانزلاق؛ فجوة وصول الرصد فوق ثانيتين تستبعدها، وهدوء السعر وحده لا يستبعدها. السواب غير محسوب فيها. التحسّن السابق لا يضمن ربحاً لاحقاً."; color: root.theme-choice == 1 ? #62758b : #999ca5; wrap: word-wrap; }
        } }
        if root.page == 21: ScrollView { VerticalBox { spacing: 14px;
            HorizontalLayout {spacing:11px;
                Card {theme-choice:root.theme-choice;label:"MODE / الوضع الحالي";value:root.trade-mode == 3 ? "SNIPER" : root.trade-mode == 2 ? "EXPERT" : root.trade-mode == 1 ? "SWING" : "SCALPING";}
                Card {theme-choice:root.theme-choice;label:"BROKER / نوع الحساب";value:root.account-mode-label;}
                Card {theme-choice:root.theme-choice;label:"BRAIN MONITOR / حالة البيانات";value:root.brain-monitor-busy ? "جارٍ التحديث" : root.brain-monitor-available ? "بيانات متاحة" : "غير متاح";}
            }
            Text { text: "غرفة العقول • الحالة والتحكم"; color: root.theme-choice == 1 ? #172235 : #f6f6f7; font-size: 24px; font-weight: 700; }
            Text { text: root.brain-monitor-summary; color: root.theme-choice == 1 ? #65778b : #b8bbc3; wrap: word-wrap; }
            Rectangle {
                background:root.theme-choice==1?#ffffff:root.theme-choice==2?#30353d:#162432;
                border-width:1px;border-color:root.theme-choice==1?#e0e6ed:#344556;
                border-radius:13px;
                VerticalLayout {padding:14px;spacing:10px;
                    Text {text:"ضبط العقل المختار • لا تتغير الأذونات قبل الحفظ";color:root.theme-choice==1?#243a52:#e2f2ff;font-weight:700;}
            ComboBox { model: root.brain-monitor-names; current-index <=> root.brain-monitor-selected; enabled: !root.brain-monitor-busy; selected(value) => { root.brain-monitor-action("select"); } }
            Text { text: "المشاركة تؤثر في قرار الخبير أو القناص المتعلّم فقط عند اختياره. سكالبينغ وسوينغ والقناص الكلاسيكي لا تتوقف إشاراتها بسبب اعتراض العقول الأخرى. صفقات Paper تحسب نتائج افتراضية من الأسعار المرصودة فقط، ولا تعلّم تلقائياً أوزان تنفيذ MT5. التعلم المطبق يعتمد على أدلة MT5 Demo المغلقة أو رصد لاحق موسوم بوضوح."; color: root.theme-choice == 1 ? #65778b : #b8bbc3; wrap: word-wrap; }
            CheckBox { text: "السماح بالمشاركة في قرار الوضع الحالي"; checked <=> root.brain-advisor; enabled: root.brain-monitor-available && !root.brain-monitor-busy && root.brain-monitor-selected != 0 && root.state == "STOPPED"; }
            CheckBox { text: "السماح بصفقات تدريب افتراضية جديدة"; checked <=> root.brain-paper; enabled: root.brain-monitor-available && !root.brain-monitor-busy && root.brain-monitor-selected != 0 && root.state == "STOPPED"; }
            HorizontalBox {
                Button { text: "حفظ تحكم العقل"; enabled: root.brain-monitor-available && !root.brain-monitor-busy && root.brain-monitor-selected != 0 && root.state == "STOPPED"; clicked => { root.brain-monitor-action("save"); } }
                Button { text: "تحديث الحالة"; enabled: !root.brain-monitor-busy; clicked => { root.brain-monitor-action("refresh"); } }
            }
                }
            }
            Text { text: "اختبار Shadow مجمّد — ينسخ إعدادات العقل المستشار الحالية كما هي، ويقارنها على أسعار لاحقة فقط، ولا يرسل أي أمر إلى MT5"; color: root.theme-choice == 1 ? #65778b : #b8bbc3; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "جمّد نسخة تجريبية"; enabled: root.frozen-trial-available && !root.brain-monitor-busy && root.brain-monitor-selected > 0 && root.brain-monitor-selected != 16 && root.state == "STOPPED"; clicked => { root.brain-monitor-action("freeze"); } }
                Button { text: "إنهاء التجربة المجمّدة"; enabled: root.frozen-trial-available && !root.brain-monitor-busy && root.brain-monitor-selected > 0 && root.brain-monitor-selected != 16 && root.state == "STOPPED"; clicked => { root.brain-monitor-action("stop_frozen"); } }
            }
            Text { text: "نسخة سياسة منسّق Expert ثابتة (Demo فقط) — تراقب اختلاف قرارات SYSTEM ولا ترسل أوامر؛ ليست نسخة محاكاة للوسيط أو قاطع المخاطرة."; color: root.theme-choice == 1 ? #65778b : #b8bbc3; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "جمّد سياسة المنسّق"; enabled: root.frozen-trial-available && !root.brain-monitor-busy && root.brain-monitor-selected == 0 && root.state == "STOPPED"; clicked => { root.brain-monitor-action("freeze_coordinator"); } }
                Button { text: "إنهاء تدقيق المنسّق"; enabled: root.frozen-trial-available && !root.brain-monitor-busy && root.brain-monitor-selected == 0 && root.state == "STOPPED"; clicked => { root.brain-monitor-action("stop_coordinator"); } }
            }
            Text { text: root.brain-monitor-message; color: root.theme-choice == 1 ? #526477 : #d0d3da; wrap: word-wrap; }
            Rectangle {
                background:root.theme-choice==1?#ffffff:root.theme-choice==2?#30353d:#162432;
                border-radius:13px;border-width:1px;border-color:root.theme-choice==1?#e0e6ed:#344556;
                VerticalLayout {padding:14px;spacing:10px;
                    Text {text:"تقرير حالة العقل من Core";color:root.theme-choice==1?#1b3851:#e3f4ff;font-weight:700;font-size:16px;}
            Text { text: root.brain-monitor-detail; color: root.theme-choice == 1 ? #28384b : #e3e5e9; wrap: word-wrap; }
                }
            }
