                        Rectangle { height: 1px; background: root.theme-choice == 1 ? #e3e9f0 : #3d4047; }
                        Text { text: "تفاصيل التكلفة ونقطة التعادل"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-weight: 700; }
                        Text { text: root.cost-detail; color: root.theme-choice == 1 ? #28384b : #e0e2e5; wrap: word-wrap; }
                        Text { text: root.studio-message; color: root.theme-choice == 1 ? #61768b : #bfc2ca; wrap: word-wrap; }
                    }
                }
            }
        }
        if root.page == 15: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "مختبر توليد الاستراتيجيات"; font-size: 20px; color: root.theme-choice == 1 ? #19283b : #f2f2f4; }
            Text { text: "يبني 40 تركيباً من الاختراق والارتداد والاتجاه واختبارات وايكوف، ثم يرتبها بالتدريب والتحقق الزمني. الاختبار النهائي محفوظ ولا يختار الاستراتيجية. لا تفعيل تلقائي للنتائج."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            ComboBox { model: root.studio-frames; current-index <=> root.studio-tf; }
            HorizontalBox {
                Button { text: "توليد وتقييم"; enabled: !root.studio-busy && !root.studio-cancel-busy; clicked => { root.studio-action("run"); } }
                Button { text: "تعلم تلقائي"; enabled: !root.studio-busy && !root.studio-cancel-busy; clicked => { root.studio-action("auto_on"); } }
                Button { text: root.studio-cancel-busy ? "جارٍ إلغاء المختبر..." : "إيقاف وإلغاء"; enabled: !root.studio-cancel-busy; clicked => { root.studio-action("cancel"); } }
            }
            Text { text: "التعلم التلقائي ينتظر اختباراً نهائياً جديداً. يدعم فريمات MT5 الـ21 ولا يعوض التاريخ المفقود ببيانات مصطنعة."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: root.studio-message; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            ComboBox { model: root.studio-reports; current-index <=> root.studio-report-index; }
            Button { text: "فتح النتيجة المحفوظة"; enabled: !root.studio-busy && !root.studio-cancel-busy && root.studio-reports.length > 0; clicked => { root.studio-action("report"); } }
            Text { text: root.studio-report; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; }
            Text { text: root.studio-summary; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 16: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "عقل وايكوف — الرصد وقياس النتيجة"; font-size: 20px; color: root.theme-choice == 1 ? #19283b : #f2f2f4; }
            ComboBox { model: root.studio-frames; current-index <=> root.studio-tf; selected => { root.studio-action("refresh"); } }
            Button { text: "تحديث التحليل"; enabled: !root.studio-busy && !root.studio-cancel-busy; clicked => { root.studio-action("refresh"); } }
            Text { text: "يرصد Spring / Upthrust واختبارهما وSOS → LPS وSOW → LPSY. يحفظ أول إشارة ثم يقيس الصافي بعد 12 شمعة لاحقة مع التكلفة. نتائج التعلم تُعرض هنا؛ تشغيل وايكوف منفرداً من صفحة التنفيذ."; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; }
            Text { text: root.wyckoff-detail; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; horizontal-alignment: left; }
            Text { text: root.studio-message; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
        } }
        if root.page == 13: ScrollView { VerticalBox { spacing: 12px;
            Text { text: "النسخ الاحتياطية ونقل العقل"; color: root.theme-choice == 1 ? #19283b : #f2f2f4; font-size: 20px; }
            Text { text: "Brain Snapshot ينقل التعلم المتراكم، نماذج التعلم، نتائج الصفقات/Coordinator وStrategy Studio إلى كمبيوتر آخر بملف .btbrain واحد. لا ينقل أسرار Telegram ولا journal إرسال الأوامر. للاستمرار الدقيق بأوزان Coordinator استخدم نفس الحساب/Server/Symbol."; color: root.theme-choice == 1 ? #28384b : #e0e1e4; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "حفظ العقل إلى ملف"; enabled: !root.backup-busy; clicked => { root.backup-action("brain_export"); } }
                Button { text: "استيراد العقل من ملف"; enabled: !root.backup-busy && root.state == "STOPPED"; clicked => { root.backup-action("brain_import"); } }
            }
            Text { text: "النسخ الداخلية الكاملة"; color: root.theme-choice == 1 ? #62758b : #999ca5; font-size: 14px; }
            HorizontalBox {
                Button { text: "تحديث القائمة"; enabled: !root.backup-busy; clicked => { root.backup-action("refresh"); } }
                Button { text: "إنشاء نسخة الآن"; enabled: !root.backup-busy; clicked => { root.backup-action("create"); } }
            }
            ComboBox { model: root.backup-names; current-index <=> root.backup-selected; enabled: !root.backup-busy; }
            HorizontalBox {
                Button { text: "فحص النسخة المختارة"; enabled: !root.backup-busy && root.backup-names.length > 0; clicked => { root.backup-action("validate"); } }
                Button { text: "استعادة وإغلاق التطبيق"; enabled: !root.backup-busy && root.backup-names.length > 0 && root.state == "STOPPED"; clicked => { root.backup-action("restore"); } }
            }
            Text { text: "أوقف النظام أولاً للاستعادة. افتح BrainTrade.exe بعد الإغلاق، ثم راجع نتيجة الاستعادة أدناه. النسخ القديمة غير المتوافقة تظهر مع سبب الرفض."; color: root.theme-choice == 1 ? #526477 : #c8cbd1; wrap: word-wrap; }
            Text { text: root.backup-detail; color: root.theme-choice == 1 ? #5d6c7e : #b7bac3; wrap: word-wrap; horizontal-alignment: left; }
        } }
        if root.page == 0: ScrollView {
            VerticalBox { spacing: 14px;
                // Compact hero: confidence and decision come directly from the Core,
