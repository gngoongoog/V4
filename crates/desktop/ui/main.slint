                                Rectangle {horizontal-stretch:1;background:transparent;}
                                Text {text:root.chart-frame==0?"M1":root.chart-frame==1?"M5":"M15";color:root.theme-choice==1?#556b81:#acbbca;font-size:12px;}
                            }
                            Rectangle {
                                height: 304px; clip: true;
                                background: root.theme-choice == 1 ? #f8fbfe : root.theme-choice == 2 ? #252b34 : #0e1b29;
                                border-radius: 9px;
                                Rectangle {x:0px;y:76px;width:parent.width;height:1px;background:root.theme-choice==1?#e7eff6:#33434d;}
                                Rectangle {x:0px;y:152px;width:parent.width;height:1px;background:root.theme-choice==1?#e7eff6:#33434d;}
                                Rectangle {x:0px;y:228px;width:parent.width;height:1px;background:root.theme-choice==1?#e7eff6:#33434d;}
                                Rectangle {x:parent.width/4;y:0px;width:1px;height:parent.height;background:root.theme-choice==1?#eef4f7:#293640;}
                                Rectangle {x:parent.width/2;y:0px;width:1px;height:parent.height;background:root.theme-choice==1?#eef4f7:#293640;}
                                Rectangle {x:parent.width*3/4;y:0px;width:1px;height:parent.height;background:root.theme-choice==1?#eef4f7:#293640;}
                                for bar in root.chart-bars: Rectangle {
                                    x: 12px + bar.x * (parent.width - 24px);
                                    y: 8px + bar.high-y * (parent.height - 16px);
                                    width: 2px;
                                    height: (bar.low-y - bar.high-y) * (parent.height - 16px);
                                    background: bar.up ? #17c8a6 : #ee6677;
                                }
                                for bar in root.chart-bars: Rectangle {
                                    x: 10px + bar.x * (parent.width - 24px);
                                    y: 8px + bar.body-top * (parent.height - 16px);
                                    width: root.chart-bars.length > 0 ? (parent.width - 24px) / root.chart-bars.length * 0.65 : 5px;
                                    height: (bar.body-bottom - bar.body-top) * (parent.height - 16px) + 2px;
                                    background: bar.up ? #16caaa : #ee6174;
                                    border-radius: 1px;
                                }
                                if root.chart-bars.length == 0: Text {
                                    text: "بانتظار شموع MT5 مكتملة وحديثة لهذا الرمز — لا نعرض شارتاً افتراضياً";
                                    color: root.theme-choice == 1 ? #61758b : #a8b6c6;
