import { AboutSlint, Palette, ComboBox, Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
export struct NewsRow {title:string,detail:string,url:string}

component Card inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: #151f30;
    border-radius: 10px;
    min-height: 96px;
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.label; color: #8d9cb4; font-size: 13px; }
        Text { text: root.value; color: #f1f5fc; font-size: 23px; font-weight: 700; }
    }
}
export component Dashboard inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "BRAINTRADE OS | Research 0.7.0";
    preferred-width: 1120px; preferred-height: 820px; min-width: 880px; min-height: 700px;
    background: #0b1220;
    in-out property <int> page: 0;
    in property <bool> execution-active: false;
    in property <bool> exec-busy: false;
    in property <[string]> exec-names;
    in-out property <int> exec-selected: 0;
    in-out property <int> exec-target: 0;
    in-out property <int> exec-frame: 0;
    in-out property <string> exec-lots: "0.01";
    in-out property <string> exec-stop: "1.5";
    in-out property <string> exec-reward: "2";
    in-out property <string> exec-hold: "1800";
    in-out property <string> exec-cooldown: "0";
    in-out property <string> exec-deviation: "20";
    in-out property <string> exec-report;
    in-out property <bool> exec-risk: false;
    in-out property <bool> portfolio-enabled: false;
    in-out property <string> portfolio-max-positions: "3";
    in-out property <string> portfolio-max-lots: "0.30";
    in-out property <string> portfolio-max-risk: "2.0";
    in property <bool> exec-enabled: false;
    in property <string> exec-role: "coordinator";
    in property <string> exec-summary: "اربط حساب Demo ثم START. العقول أعضاء افتراضياً؛ زر منفرد يغيّر عضوية العقل المختار.";
    in property <string> exec-detail;
    in property <string> exec-ledger;
    in property <string> exec-message;
    in property <[string]> exec-frames;
    callback execution-action(string);
    in-out property <int> trade-mode: 2;
    in-out property <string> sniper-target: "50";
    in-out property <string> sniper-stop: "80";
    in-out property <string> sniper-cooldown: "0";
    in-out property <string> pip-points: "10";
    in-out property <string> cost-fraction: "0.45";
    in-out property <string> preview-lots: "0.1";
    in property <bool> studio-busy: false;
    in property <string> studio-message: "";
    in property <string> cost-detail: "7 لكل لوت × 0.1 = 0.70 من عملة الحساب. السبريد يحتاج اتصال MT5.";
    in property <string> studio-summary: "بانتظار تحميل الفريمات";
    in property <string> studio-report: "اختر نتيجة محفوظة بعد انتهاء التقييم. نحتاج 400 شمعة فعلية لكل فريم على الأقل.";
    in property <string> wyckoff-detail: "بانتظار الشموع المكتملة";
    in property <[string]> studio-frames;
    in-out property <int> studio-tf: 0;
    in property <[string]> studio-reports;
    in property <[string]> studio-ids;
    in-out property <int> studio-report-index: 0;
    callback studio-action(string);
    in property <string> state: "CONNECTING";
    in property <string> connection: "Waiting for core";
    in property <string> balance: "—";
    in property <string> equity: "—";
    in property <string> today: "—";
    in property <string> positions: "No current MT5 snapshot";
    in property <string> diagnostics: "";
    in property <string> events: "";
    in property <string> feedback: "";
    in property <string> account: "No account connected";
    in property <string> telegram-status: "Not configured";
    in property <bool> online: false;
    in property <bool> busy: false;
    in property <bool> token-saved: false;
    in-out property <string> mt5-path;
    in-out property <string> symbol: "XAUUSD";
    in-out property <string> telegram-user;
    in-out property <string> telegram-chat;
    in-out property <string> telegram-token;
    in-out property <bool> telegram-enabled: false;
    in-out property <bool> clear-token: false;
    in property <string> opportunities: "بانتظار البيانات";
    in property <string> market-map: "بانتظار البيانات";
    in property <string> opportunity-history: "اضغط عرض سجل الفرص لقراءة أول رصد محفوظ.";
    callback load-opportunity-history();
    in property <string> learning-summary: "افتح صفحة التعلم لتحديث البيانات";
    in property <string> learning-status: "لم يُحدّث بعد";
    in property <string> learning-detail: "صدّر dataset للتدريب الخارجي، ثم استورد ملف النموذج. يلزم دليل زمني متوافق قبل تسجيل المراجعة.";
    in property <string> learning-model;
    in property <bool> learning-busy: false;
    in property <bool> learning-review-ready: false;
    in-out property <string> learning-note;
    callback learning-action(string);
    in property <bool> learning-performance-ready: false;
    in property <string> learning-signature;
    in-out property <string> learning-record;
    in property <[string]> backup-names;
    in-out property <int> backup-selected: 0;
    in property <bool> backup-busy: false;
    in property <string> backup-detail: "اضغط تحديث لعرض النسخ";
    callback backup-action(string);
    in property <string> brains: "Waiting for closed M1/M5/M15 candles";
    in property <string> paper: "Virtual trades appear after START and an eligible signal";
    in property <string> regime: "UNKNOWN";
    in property <string> decision: "WAIT";
    in-out property <string> risk-percent: "0.25";
    in-out property <string> daily-limit: "2";
    in-out property <string> drawdown-limit: "5";
    in-out property <string> spread-limit: "0.25";
    in-out property <string> max-lots: "0.10";
    in-out property <string> commission-lot: "7";
    in-out property <string> slippage-ticks: "2";
    in-out property <string> bt-from;
    in-out property <string> bt-to;
    in-out property <string> bt-equity: "10000";
    in-out property <string> bt-spread: "0.20";
    in-out property <int> bt-strategy: 0;
    in property <string> bt-status: "Waiting for core";
    in property <string> bt-report: "لا توجد نتيجة بعد. اختر فترة UTC وجلب بيانات MT5، أو افتح اختباراً محفوظاً.";
    in property <string> bt-report-id;
    in property <string> bt-net: "—";
    in property <string> bt-trades: "—";
    in property <string> bt-drawdown: "—";
    in property <[string]> bt-runs;
    in property <[string]> bt-ids;
    in-out property <int> bt-selected: -1;
    in property <bool> bt-busy: false;
    in property <bool> bt-active: false;
    callback backtest-action(string);
    in property <[string]> ev-source-runs;
    in property <[string]> ev-source-ids;
    in-out property <int> ev-source-selected: -1;
    in-out property <int> ev-plan: 0;
    in-out property <string> ev-holdout-percent: "30";
    in-out property <string> ev-development-days: "5";
    in-out property <string> ev-holdout-days: "2";
    in-out property <string> ev-step-days: "2";
    in property <string> ev-status: "Waiting for core";
    in property <string> ev-report: "لا يوجد دليل تقييم زمني معروض بعد.";
    in property <string> ev-report-id;
    in property <string> ev-v1-net: "—";
    in property <string> ev-v2-net: "—";
    in property <string> ev-delta: "—";
    in property <[string]> ev-runs;
    in property <[string]> ev-ids;
    in-out property <int> ev-selected: -1;
    in property <bool> ev-busy: false;
    in property <bool> ev-active: false;
    callback evaluation-action(string);
    in property <[NewsRow]> news-items;
    in property <string> news-status: "بانتظار المحرك";
    in property <string> news-sources;
    in property <bool> news-enabled: true;
    in property <bool> news-refreshing: false;
    in property <bool> news-empty: true;
    callback news-action(string);
    callback open-news(string);
    callback save-risk();
    callback action(string);
    callback save-settings();
    callback browse-mt5();
    VerticalLayout {
        padding: 24px; spacing: 16px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                Text { text: "BRAINTRADE OS"; color: #f5f7fd; font-size: 26px; font-weight: 800; }
                Text { text: "مركز التحكم  /  RESEARCH 0.7.0"; color: #8d9cb4; font-size: 13px; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.state; color: root.online ? #5be0be : #f0c578; font-size: 16px; vertical-alignment: center; }
        }
        Rectangle {
            background: #242337; border-radius: 8px; height: 46px;
            Text { x: 14px; width: parent.width - 28px; height: parent.height; text: root.execution-active ? "تنفيذ MT5 فعّال — العقول المشغّلة تتداول على الحساب المرتبط" : "التنفيذ متوقف — اختر حساب الديمو والعقل من صفحة التنفيذ المنفرد"; color: #eedaa5; vertical-alignment: center; horizontal-alignment: center; }
        }
        HorizontalLayout {
            spacing: 10px;
            Button { text: "تشغيل النظام  START"; enabled: !root.busy; clicked => { root.action("start"); } }
            Button { text: "إيقاف النظام  STOP"; enabled: !root.busy; clicked => { root.action("stop"); } }
            Button { text: "إعادة الاتصال بـ MT5"; enabled: !root.busy; clicked => { root.action("reconnect"); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.decision; color: #6bdbc5; vertical-alignment: center; }
        }
        VerticalLayout {spacing: 6px;
          HorizontalLayout {spacing: 8px;
            Button { text: "العقول والتحليل"; clicked => { root.page = 4; } }
            Button { text: "المحاكاة"; clicked => { root.page = 5; } }
            Button { text: "الاختبار التاريخي"; clicked => { root.page = 7; } }
            Button { text: "المخاطرة"; clicked => { root.page = 6; } }
            Button {text: "الأخبار الرسمية"; clicked => {root.page = 8;} }
          }
          HorizontalLayout {spacing: 8px;
            Button { text: "التقييم الزمني"; clicked => { root.page = 9; root.evaluation-action("refresh"); } }
            Button { text: "الرئيسية"; clicked => { root.page = 0; } }
            Button { text: "الإعدادات"; clicked => { root.page = 1; } }
            Button { text: "السجل"; clicked => { root.page = 2; root.action("events"); } }
            Button { text: "حول"; clicked => { root.page = 3; } }
          }
        }
        HorizontalLayout { spacing: 8px;
            Button { text: "فرص السوق"; clicked => { root.page = 10; } }
            Button { text: "خريطة العقول والمناطق"; clicked => { root.page = 12; } }
            Button { text: "التعلم ومراجعة النماذج"; clicked => { root.page = 11; root.learning-action("refresh"); } }
        }
        HorizontalLayout { spacing: 8px;
            Button { text: "أوضاع التداول والتكلفة"; clicked => { root.page = 14; root.studio-action("config"); } }
            Button { text: "مختبر الاستراتيجيات"; clicked => { root.page = 15; root.studio-action("refresh"); } }
            Button { text: "وايكوف والتعلم"; clicked => { root.page = 16; root.studio-action("refresh"); } }
            Button { text: "التنفيذ المنفرد"; clicked => { root.page = 17; root.execution-action("refresh"); } }
        }
        if root.page == 17: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "تنفيذ MT5 — لكل عقل قراره وصفقاته"; color: #eaf0fb; font-size: 20px; }
            Text { text: root.exec-summary; color: #8ddfc6; wrap: word-wrap; }
            HorizontalBox {
                ComboBox { model: ["Demo / حساب تجريبي", "Live / أموال حقيقية"]; current-index <=> root.exec-target; }
                LineEdit { text <=> root.exec-deviation; placeholder-text: "انحراف التنفيذ بالنقاط"; }
                Button { text: "ربط الحساب الحالي"; enabled: !root.exec-busy; clicked => { root.execution-action("bind"); } }
            }
            Text { text: "الربط يثبت رقم الحساب والخادم ونوعه. انتقالك إلى حساب آخر لا يفعّل التداول عليه تلقائيًا."; color: #acbad0; wrap: word-wrap; }
            ComboBox { model: root.exec-names; current-index <=> root.exec-selected; selected(value) => { root.execution-action("select"); } }
            HorizontalBox {
                Button { text: "تشغيل تداول منفرد"; enabled: !root.exec-busy && root.exec-selected != 0 && !root.exec-enabled; clicked => { root.execution-action("enable"); } }
                Button { text: "حفظ إعدادات العقل"; enabled: !root.exec-busy; clicked => { root.execution-action("save"); } }
                Button { text: "إرجاع للمنظومة"; enabled: !root.exec-busy && root.exec-selected != 0 && root.exec-enabled; clicked => { root.execution-action("disable"); } }
            }
            Text { text: root.exec-role == "coordinator" ? "العقل الرئيسي المتعلم — يتبع START/STOP والوضع المختار" : root.exec-role == "returning" ? "بانتظار الرجوع: يكمل إدارة صفقته الحالية ثم يعود تابعاً للرئيسي" : root.exec-role == "solo" ? "منفرد: مستبعد من تصويت المنظومة ويتداول بقراره" : "عضو في المنظومة: يرسل تحليله للرئيسي ولا يفتح صفقة باسمه"; color: root.exec-enabled ? #5be0be : #f0c578; wrap: word-wrap; }
            HorizontalBox {
                Text { text: "الفريم"; color: #acbad0; vertical-alignment: center; }
                ComboBox { model: root.exec-frames; current-index <=> root.exec-frame; }
                Text { text: "اللوت الثابت"; color: #acbad0; vertical-alignment: center; }
                LineEdit { text <=> root.exec-lots; }
            }
            Text { text: "الوقف ATR / الهدف R / أقصى احتفاظ بالثواني (0 بلا مهلة) / فاصل دخول بالثواني"; color: #acbad0; wrap: word-wrap; }
            HorizontalBox {
                LineEdit { text <=> root.exec-stop; }
                LineEdit { text <=> root.exec-reward; }
                LineEdit { text <=> root.exec-hold; }
                LineEdit { text <=> root.exec-cooldown; }
            }
            Text { text: "عقل النظام يستخدم هندسة الوضع المختار. KTE يستخدم وقفه البنيوي؛ الاستراتيجية المولدة تستخدم إعدادات تقريرها."; color: #acbad0; wrap: word-wrap; }
            CheckBox { text: "تفعيل حدود المخاطرة واللوت والسبريد الاختيارية من صفحة المخاطرة"; checked <=> root.exec-risk; }
            LineEdit { text <=> root.exec-report; placeholder-text: "للعقل المولّد فقط: معرّف تقرير محفوظ من مختبر الاستراتيجيات"; }
            Rectangle { height: 1px; background: #263145; }
            Text { text: "حماية المحفظة — حد إجمالي عبر جميع العقول"; color: #eaf0fb; font-size: 18px; }
            CheckBox { text: "تفعيل Portfolio Exposure Gate للدخولات الجديدة"; checked <=> root.portfolio-enabled; }
            Text { text: "أقصى عدد صفقات/أوامر غير محسومة • أقصى مجموع لوت • أقصى خطر وقف % من Equity"; color: #acbad0; wrap: word-wrap; }
            HorizontalBox {
                LineEdit { text <=> root.portfolio-max-positions; placeholder-text: "3"; }
                LineEdit { text <=> root.portfolio-max-lots; placeholder-text: "0.30"; }
                LineEdit { text <=> root.portfolio-max-risk; placeholder-text: "2.0"; }
                Button { text: "حفظ حماية المحفظة"; enabled: !root.exec-busy && root.state == "STOPPED"; clicked => { root.execution-action("portfolio"); } }
            }
            Text { text: "غيّر هذه الحدود فقط أثناء STOP. إذا تعذر حساب خطر وقف أي تعرض قائم، يمنع دخول جديد عند تفعيل الحماية؛ الإغلاقات وSL/TP والمصالحة لا تُمنع."; color: #f0c578; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "إغلاق صفقات هذا العقل"; enabled: !root.exec-busy; clicked => { root.execution-action("close"); } }
                Button { text: "تحديث النتائج والأوامر"; enabled: !root.exec-busy; clicked => { root.execution-action("poll"); } }
            }
            Text { text: root.exec-message; color: #f0c578; wrap: word-wrap; }
            Text { text: root.exec-detail; color: #d1ddef; wrap: word-wrap; }
            Text { text: "نتائج مستقلة لكل عقل وسجل التنفيذ"; color: #eaf0fb; font-size: 18px; }
            Text { text: root.exec-ledger; color: #acbad0; wrap: word-wrap; }
            Text { text: "حساب Hedging يسمح باستقلال صفقات عدة عقول. Netting يسمح بمالك واحد للرمز حتى إغلاقه. الأخبار وتوقعات النماذج الإحصائية تبقى مصادر بحث، وليست استراتيجيات مكتملة للتداول المنفرد."; color: #acbad0; wrap: word-wrap; }
        } }
        if root.page == 14: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "أوضاع تشغيل المنظومة — المنسق الرئيسي"; font-size: 20px; color: #eaf0fb; }
            ComboBox { model: ["Scalping / سكالبنك", "Swing / سوينك", "Expert / الخبير المتعلم", "Sniper / القناص"]; current-index <=> root.trade-mode; }
            Text { text: root.trade-mode == 0 ? "M1 + M5؛ زخم مؤكد، وقف 1.2 ATR وهدف 1.4R، أقصى احتفاظ 15 دقيقة." : root.trade-mode == 1 ? "H1 + H4 + D1؛ اتجاهات متوافقة، وقف 2 ATR وهدف 2.5R، أقصى احتفاظ 3 أيام. السواب غير محسوب." : root.trade-mode == 2 ? "الخبير: تصويت الأعضاء بأوزان تتعلم من نتائج لاحقة؛ يستبعد العقول المنفردة. وقف 1.5 ATR وهدف 2R؛ مهلة 30 دقيقة." : "اختراق لحظي بالسعر لنطاق 6 شموع M1 مكتملة مع اتجاه M5. مهلة دقيقتين؛ انتظار 100ms عند تفعيل التنفيذ، يضاف وقت MT5 والمعالجة."; color: #acbad0; wrap: word-wrap; }
            Text { text: "العمولة ذهاب وإياب لكل 1.00 لوت — بعملة الحساب. أدخل مجموع عمولة الدخول والخروج."; color: #d5deed; wrap: word-wrap; }
            HorizontalBox {
                LineEdit { text <=> root.commission-lot; placeholder-text: "7"; }
                Text { text: "نقاط في pip واحد"; color: #acbad0; vertical-alignment: center; }
                LineEdit { text <=> root.pip-points; }
            }
            Text { text: "القناص: هدف صافي بالنقاط / وقف بالنقاط / انتظار بالثواني / أقصى حصة تكلفة"; color: #acbad0; wrap: word-wrap; }
            HorizontalBox {
                LineEdit { text <=> root.sniper-target; placeholder-text: "الهدف"; }
                LineEdit { text <=> root.sniper-stop; placeholder-text: "الوقف"; }
                LineEdit { text <=> root.sniper-cooldown; placeholder-text: "الانتظار"; }
                LineEdit { text <=> root.cost-fraction; placeholder-text: "0.45"; }
            }
            Text { text: "حصة التكلفة = التكلفة ÷ (التكلفة + الهدف الصافي). عند تجاوز الحد ينتظر القناص. تعريف pip قابل للتعديل لاختلاف المعادن والمؤشرات."; color: #acbad0; wrap: word-wrap; }
            Button { text: "حفظ الوضع والعمولة"; enabled: !root.studio-busy && root.state == "STOPPED"; clicked => { root.studio-action("save"); } }
            Text { text: "أوقف النظام لتبديل الوضع. الصفقات المفتوحة تحتفظ بهدفها ووقفها ومدتها الأصلية. المحاكاة لها سجل منفصل."; color: #f0c578; wrap: word-wrap; }
            HorizontalBox {
                Text { text: "اللوت للحساب"; color: #d5deed; vertical-alignment: center; }
                LineEdit { text <=> root.preview-lots; }
                Button { text: "احسب العمولة والسبريد"; enabled: !root.studio-busy; clicked => { root.studio-action("cost"); } }
            }
            Text { text: root.cost-detail; color: #6bdbc5; wrap: word-wrap; }
            Text { text: root.studio-message; color: #f0c578; wrap: word-wrap; }
        } }
        if root.page == 15: ScrollView { VerticalBox { spacing: 10px;
            Text { text: "مختبر توليد الاستراتيجيات"; font-size: 20px; color: #eaf0fb; }
            Text { text: "يبني 40 تركيباً من الاختراق والارتداد والاتجاه واختبارات وايكوف، ثم يرتبها بالتدريب والتحقق الزمني. الاختبار النهائي محفوظ ولا يختار الاستراتيجية. لا تفعيل تلقائي للنتائج."; color: #acbad0; wrap: word-wrap; }
            ComboBox { model: root.studio-frames; current-index <=> root.studio-tf; }
            HorizontalBox {
                Button { text: "توليد وتقييم"; enabled: !root.studio-busy; clicked => { root.studio-action("run"); } }
                Button { text: "تعلم تلقائي"; enabled: !root.studio-busy; clicked => { root.studio-action("auto_on"); } }
                Button { text: "إيقاف وإلغاء"; enabled: !root.studio-busy; clicked => { root.studio-action("cancel"); } }
            }
            Text { text: "التعلم التلقائي ينتظر اختباراً نهائياً جديداً. يدعم فريمات MT5 الـ21 ولا يعوض التاريخ المفقود ببيانات مصطنعة."; color: #acbad0; wrap: word-wrap; }
            Text { text: root.studio-message; color: #f0c578; wrap: word-wrap; }
            ComboBox { model: root.studio-reports; current-index <=> root.studio-report-index; }
            Button { text: "فتح النتيجة المحفوظة"; enabled: !root.studio-busy && root.studio-reports.length > 0; clicked => { root.studio-action("report"); } }
