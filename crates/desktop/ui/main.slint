                        Rectangle {width:1px;background:root.theme-choice==1?#dae6ec:#41515d;}
                        Text {text:"QUOTE AGE / عمر السعر  "+root.quote-age-display;color:root.theme-choice==1?#4a6878:#bdcdd3;font-size:11px;vertical-alignment:center;}
